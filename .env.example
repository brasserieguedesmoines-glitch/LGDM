# Identifiants API EasyBeer
# Récupérés dans EasyBeer > Paramètres > Intégrations partenaires > Accès API, Webhooks & MCP
# IMPORTANT : régénérer ces identifiants après les tests (bouton de régénération dans EasyBeer)
EASYBEER_API_USER=votre_identifiant_api
EASYBEER_API_PASSWORD=votre_mot_de_passe_api
EASYBEER_BASE_URL=https://api.easybeer.fr

# Port du serveur (Railway le définit automatiquement)
PORT=3000
