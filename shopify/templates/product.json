      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Comment conserver vos bières ?",
            "answer": "<p>Nous recommandons de conserver nos bières debout, à l'abri de la lumière et à une température idéale entre 8 et 12°C pour préserver leurs arômes.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Quelle est la durée de vie de vos bières ?",
            "answer": "<p>Nos bières artisanales se conservent environ un an et demi. La date limite d'utilisation optimale (DLUO) est indiquée sur chaque bouteille.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Comment bien déguster vos bières ?",
            "answer": "<p>Servez nos bières à la bonne température : entre 6 et 8°C pour une blonde, 8-10°C pour une ambrée et 10-12°C pour une brune. Utilisez un verre adapté pour libérer les arômes.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Peut-on visiter la brasserie ?",
            "answer": "<p>Oui, nous proposons des visites. Vous pourrez découvrir notre processus de fabrication et profiter d'une dégustation de nos bières artisanales.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Vos bières contiennent-elles des allergènes ?",
            "answer": "<p>Nos bières contiennent du gluten provenant des malts d'orge et de blé. Certains brassins spéciaux peuvent contenir des fruits ou épices, mentionnés sur l'étiquette.</p>"
          }
        }
      },
