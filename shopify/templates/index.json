      "settings": {
        "custom_liquid": "<section class=\"gdm-nav3\" aria-label=\"Brasserie, Brewpub et E-Shop — Le Gué des Moines\">\n<style>\n.gdm-nav3{--acc:#FF9900;--acc-g:rgba(255,153,0,.10);--acc-b:rgba(255,153,0,.28);--c:#161616;--ln:rgba(255,255,255,.09);--ln-h:rgba(255,153,0,.35);--tx:#f2f0ec;--mu:rgba(242,240,236,.68);background:transparent;padding:56px 20px;font-family:'DM Sans',sans-serif;}\n.gdm-nav3 *{box-sizing:border-box;margin:0;padding:0;}\n.gdm-nav3 a{text-decoration:none;}\n.gdm-n3-wrap{max-width:1180px;margin:0 auto;}\n \n.gdm-n3-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:28px;flex-wrap:wrap;}\n.gdm-n3-head-left{}\n.gdm-n3-kicker{display:inline-flex;align-items:center;gap:7px;background:var(--acc-g);border:1px solid var(--acc-b);color:#ffc966;padding:5px 14px;border-radius:999px;font-size:10.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;margin-bottom:12px;}\n.gdm-n3-kicker-dot{width:5px;height:5px;border-radius:50%;background:var(--acc);}\n.gdm-n3-title{font-family:'Barlow Condensed',sans-serif;font-size:clamp(28px,4vw,44px);font-weight:800;text-transform:uppercase;line-height:1.0;color:var(--tx);letter-spacing:-.01em;}\n.gdm-n3-title em{font-style:normal;color:var(--acc);}\n.gdm-n3-nav{display:flex;gap:8px;align-items:center;flex-shrink:0;}\n.gdm-n3-btn-nav{width:42px;height:42px;border-radius:50%;background:var(--c);border:1px solid var(--ln);color:var(--tx);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:18px;line-height:1;transition:border-color .2s,background .2s,transform .2s;font-family:'DM Sans',sans-serif;}\n.gdm-n3-btn-nav:hover{border-color:var(--acc-b);color:var(--acc);background:var(--acc-g);transform:translateY(-1px);}\n.gdm-n3-btn-nav:disabled{opacity:.3;cursor:not-allowed;transform:none;}\n \n.gdm-n3-viewport{overflow:hidden;border-radius:20px;}\n.gdm-n3-track{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:4px 2px 16px;}\n.gdm-n3-track::-webkit-scrollbar{display:none;}\n \n.gdm-n3-card{scroll-snap-align:start;flex:0 0 clamp(280px,36vw,420px);background:var(--c);border:1px solid var(--ln);border-radius:20px;overflow:hidden;transition:border-color .25s,transform .25s;position:relative;display:flex;flex-direction:column;}\n.gdm-n3-card:hover{border-color:var(--ln-h);transform:translateY(-3px);}\n.gdm-n3-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--acc);opacity:0;transition:opacity .25s;z-index:3;}\n.gdm-n3-card:hover::before{opacity:1;}\n \n.gdm-n3-img-wrap{position:relative;width:100%;aspect-ratio:4/3;overflow:hidden;}\n.gdm-n3-img-wrap img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease;filter:brightness(.88) saturate(.95);}\n.gdm-n3-card:hover .gdm-n3-img-wrap img{transform:scale(1.05);filter:brightness(.96) saturate(1.05);}\n.gdm-n3-img-wrap::after{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,transparent 40%,rgba(22,22,22,.65) 100%);pointer-events:none;}\n \n.gdm-n3-body{padding:22px 24px 24px;display:flex;flex-direction:column;gap:10px;flex:1;}\n.gdm-n3-label{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:var(--acc);}\n.gdm-n3-name{font-family:'Barlow Condensed',sans-serif;font-size:clamp(26px,3vw,36px);font-weight:800;text-transform:uppercase;letter-spacing:-.01em;color:var(--tx);line-height:1.0;}\n.gdm-n3-desc{font-size:13.5px;color:var(--mu);line-height:1.65;flex:1;}\n.gdm-n3-details{display:flex;flex-wrap:wrap;gap:6px;margin-top:2px;}\n.gdm-n3-detail{font-size:11px;padding:3px 10px;border-radius:999px;background:rgba(255,255,255,.04);border:1px solid var(--ln);color:var(--mu);}\n.gdm-n3-cta{display:inline-flex;align-items:center;justify-content:space-between;gap:10px;width:100%;padding:13px 18px;border-radius:12px;background:var(--acc);color:#0f0f0f;font-size:13.5px;font-weight:700;font-family:'DM Sans',sans-serif;text-transform:uppercase;letter-spacing:.04em;transition:background .2s,transform .2s,box-shadow .2s;margin-top:4px;}\n.gdm-n3-cta:hover{background:#fff;transform:translateY(-1px);box-shadow:0 6px 20px rgba(255,153,0,.30);}\n.gdm-n3-arrow{font-size:16px;line-height:1;flex-shrink:0;}\n \n.gdm-n3-dots{display:flex;justify-content:center;gap:6px;margin-top:16px;}\n.gdm-n3-dot{width:6px;height:6px;border-radius:50%;background:var(--ln);border:none;padding:0;cursor:pointer;transition:background .2s,width .2s;}\n.gdm-n3-dot.active{background:var(--acc);width:20px;border-radius:3px;}\n \n@media(max-width:640px){.gdm-nav3{padding:40px 16px;}.gdm-n3-head{flex-direction:column;align-items:flex-start;}.gdm-n3-nav{align-self:flex-end;}}\n</style>\n \n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=DM+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n \n<div class=\"gdm-n3-wrap\">\n \n  <div class=\"gdm-n3-head\">\n    <div class=\"gdm-n3-head-left\">\n      <h2 class=\"gdm-n3-title\">Explorez notre <em>univers</em></h2>\n    </div>\n    <div class=\"gdm-n3-nav\">\n      <button class=\"gdm-n3-btn-nav gdm-n3-prev\" type=\"button\" aria-label=\"Précédent\">‹</button>\n      <button class=\"gdm-n3-btn-nav gdm-n3-next\" type=\"button\" aria-label=\"Suivant\">›</button>\n    </div>\n  </div>\n \n  <div class=\"gdm-n3-viewport\">\n    <div class=\"gdm-n3-track\">\n \n      <article class=\"gdm-n3-card\">\n        <div class=\"gdm-n3-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0864/4604/7574/files/BRASSERIE_ARTISANAL_LE_GUE_DES_MOINES_9e8b0033-e237-4d43-a3a0-75f2ece76781.webp?v=1730104704\" alt=\"Brasserie artisanale Le Gué des Moines à Bruguières — cuves de brassage artisanal Toulouse\" loading=\"lazy\" width=\"800\" height=\"600\">\n        </div>\n        <div class=\"gdm-n3-body\">\n          <span class=\"gdm-n3-label\">Lieu de fabrication</span>\n          <h3 class=\"gdm-n3-name\">Brasserie</h3>\n          <p class=\"gdm-n3-desc\">Découvrez l'ancienne Briqueterie de Bruguières où chaque bière est pensée, brassée et embouteillée sur place depuis 2016. Visites guidées mensuelles gratuites.</p>\n          <div class=\"gdm-n3-details\">\n            <span class=\"gdm-n3-detail\">Visite mensuelle gratuite</span>\n            <span class=\"gdm-n3-detail\">Bruguières (31150)</span>\n          </div>\n          <a href=\"/pages/brasserie-le-gue-des-moines\" class=\"gdm-n3-cta\" title=\"Découvrir la brasserie Le Gué des Moines\">\n            Vers la brasserie <span class=\"gdm-n3-arrow\">→</span>\n          </a>\n        </div>\n      </article>\n \n      <article class=\"gdm-n3-card\">\n        <div class=\"gdm-n3-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0864/4604/7574/files/BRASSERIE_ARTISANAL_LE_GUE_DES_MOINES_3_28374699-dbe3-428d-8df7-a1c1865ef037.webp?v=1730107631\" alt=\"Brewpub Le Gué des Moines — 10 bières artisanales à la pression à Bruguières, nord Toulouse\" loading=\"lazy\" width=\"800\" height=\"600\">\n        </div>\n        <div class=\"gdm-n3-body\">\n          <span class=\"gdm-n3-label\">Bar à bière artisanale</span>\n          <h3 class=\"gdm-n3-name\">Brewpub</h3>\n          <p class=\"gdm-n3-desc\">+10 bières artisanales à la pression, tapas à partager, diffusion des matchs et concerts. L'adresse conviviale du nord toulousain, ouverte du mardi au samedi.</p>\n          <div class=\"gdm-n3-details\">\n            <span class=\"gdm-n3-detail\">Mar–Mer : 16h–20h30</span>\n            <span class=\"gdm-n3-detail\">Jeu–Sam : 16h–22h30</span>\n          </div>\n          <a href=\"/pages/brewpub\" class=\"gdm-n3-cta\" title=\"Découvrir le brewpub Le Gué des Moines\">\n            Vers le brewpub <span class=\"gdm-n3-arrow\">→</span>\n          </a>\n        </div>\n      </article>\n \n      <article class=\"gdm-n3-card\">\n        <div class=\"gdm-n3-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0864/4604/7574/files/BRASSERIE_ARTISANAL_LE_GUE_DES_MOINES_2.webp?v=1730104744\" alt=\"Bières artisanales du Gué des Moines — commander en ligne avec click and collect à Bruguières\" loading=\"lazy\" width=\"800\" height=\"600\">\n        </div>\n        <div class=\"gdm-n3-body\">\n          <span class=\"gdm-n3-label\">Commande en ligne</span>\n          <h3 class=\"gdm-n3-name\">E-Shop</h3>\n          <p class=\"gdm-n3-desc\">Commandez nos bières artisanales en 33cl et 75cl depuis chez vous. Retrait en click &amp; collect à la brasserie avec <strong style=\"color:#f2f0ec\">10% de remise</strong>.</p>\n          <div class=\"gdm-n3-details\">\n            <span class=\"gdm-n3-detail\">10% click &amp; collect</span>\n            <span class=\"gdm-n3-detail\">10 bières disponibles</span>\n          </div>\n          <a href=\"/collections/bieres-artisanales-du-gue-des-moines\" class=\"gdm-n3-cta\" title=\"Commander les bières artisanales du Gué des Moines\">\n            Vers l'e-shop <span class=\"gdm-n3-arrow\">→</span>\n          </a>\n        </div>\n      </article>\n \n    </div>\n  </div>\n \n  <div class=\"gdm-n3-dots\" role=\"tablist\" aria-label=\"Navigation\">\n    <button class=\"gdm-n3-dot active\" role=\"tab\" aria-label=\"Brasserie\" aria-selected=\"true\"></button>\n    <button class=\"gdm-n3-dot\" role=\"tab\" aria-label=\"Brewpub\" aria-selected=\"false\"></button>\n    <button class=\"gdm-n3-dot\" role=\"tab\" aria-label=\"E-Shop\" aria-selected=\"false\"></button>\n  </div>\n \n</div>\n</section>\n \n<script>\n(function(){\n  const root = document.querySelector('.gdm-nav3');\n  if(!root) return;\n  const track = root.querySelector('.gdm-n3-track');\n  const cards = Array.from(root.querySelectorAll('.gdm-n3-card'));\n  const prev  = root.querySelector('.gdm-n3-prev');\n  const next  = root.querySelector('.gdm-n3-next');\n  const dots  = Array.from(root.querySelectorAll('.gdm-n3-dot'));\n  if(!track || !cards.length) return;\n \n  let current = 0;\n  const gap  = () => parseFloat(getComputedStyle(track).gap || '16');\n  const step = () => cards[0].getBoundingClientRect().width + gap();\n \n  const go = (idx) => {\n    current = Math.max(0, Math.min(idx, cards.length - 1));\n    track.scrollTo({ left: current * step(), behavior: 'smooth' });\n    update();\n  };\n \n  const update = () => {\n    if(prev) prev.disabled = current <= 0;\n    if(next) next.disabled = current >= cards.length - 1;\n    dots.forEach((d,i) => {\n      d.classList.toggle('active', i === current);\n      d.setAttribute('aria-selected', i === current ? 'true' : 'false');\n    });\n  };\n \n  if(prev) prev.addEventListener('click', () => go(current - 1));\n  if(next) next.addEventListener('click', () => go(current + 1));\n  dots.forEach((d,i) => d.addEventListener('click', () => go(i)));\n \n  track.addEventListener('scroll', () => {\n    const s = step();\n    if(s > 0) current = Math.round(track.scrollLeft / s);\n    update();\n  }, { passive: true });\n \n  update();\n})();\n</script>",
