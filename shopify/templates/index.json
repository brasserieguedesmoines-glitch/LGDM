    "custom_liquid_bwLB4x": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<section class=\"gdm-ut-compact\" aria-label=\"Avis Untappd — Le Gué des Moines\">\n<style>\n.gdm-ut-compact {\n  --acc: #FF9900;\n  --acc-g: rgba(255,153,0,0.10);\n  --acc-b: rgba(255,153,0,0.28);\n  --c: #161616;\n  --ln: rgba(255,255,255,0.09);\n  --ln-h: rgba(255,153,0,0.35);\n  --tx: #f2f0ec;\n  --mu: rgba(242,240,236,0.68);\n  --sh: 0 8px 28px rgba(0,0,0,0.28);\n  background: transparent;\n  color: var(--tx);\n  padding: 48px 20px;\n  font-family: 'DM Sans', sans-serif;\n}\n.gdm-ut-compact * { box-sizing: border-box; margin: 0; padding: 0; }\n.gdm-ut-compact a { text-decoration: none; color: inherit; }\n \n.gdm-ut-inner { max-width: 1180px; margin: 0 auto; }\n \n.gdm-ut-topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  margin-bottom: 24px;\n  flex-wrap: wrap;\n}\n.gdm-ut-brand-row { display: flex; align-items: center; gap: 14px; }\n.gdm-ut-logo {\n  width: 48px; height: 48px;\n  border-radius: 12px;\n  border: 1px solid var(--ln);\n  overflow: hidden;\n  flex-shrink: 0;\n  display: block;\n}\n.gdm-ut-logo img { width: 100%; height: 100%; object-fit: cover; display: block; }\n.gdm-ut-eyebrow {\n  font-size: 10px; font-weight: 600;\n  letter-spacing: 0.09em; text-transform: uppercase;\n  color: var(--acc); margin-bottom: 3px;\n}\n.gdm-ut-title {\n  font-family: 'Barlow Condensed', sans-serif;\n  font-size: clamp(20px, 2.5vw, 28px);\n  font-weight: 800; text-transform: uppercase;\n  line-height: 1; color: var(--tx);\n}\n.gdm-ut-title em { font-style: normal; color: var(--acc); }\n.gdm-ut-profile-link {\n  display: inline-flex; align-items: center; gap: 7px;\n  padding: 9px 18px; border-radius: 999px;\n  border: 1px solid var(--ln);\n  font-size: 12.5px; font-weight: 600; color: var(--tx);\n  transition: border-color .2s, color .2s, background .2s;\n  white-space: nowrap;\n}\n.gdm-ut-profile-link:hover { border-color: var(--acc-b); color: var(--acc); background: var(--acc-g); }\n \n.gdm-ut-stats {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 10px; margin-bottom: 20px;\n}\n.gdm-ut-stat {\n  background: var(--c);\n  border: 1px solid var(--ln);\n  border-radius: 14px;\n  padding: 14px 16px;\n  transition: border-color .2s;\n}\n.gdm-ut-stat:hover { border-color: var(--ln-h); }\n.gdm-ut-stat-val {\n  font-family: 'Barlow Condensed', sans-serif;\n  font-size: 26px; font-weight: 800;\n  color: var(--acc); line-height: 1;\n  white-space: nowrap; margin-bottom: 3px;\n}\n.gdm-ut-stat-label { font-size: 11px; color: var(--mu); line-height: 1.35; }\n.gdm-stars-sm { display: flex; gap: 2px; margin-top: 5px; }\n.gdm-stars-sm svg { width: 10px; height: 10px; }\n \n.gdm-ut-reviews {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 10px; margin-bottom: 20px;\n}\n.gdm-ut-rev {\n  background: var(--c);\n  border: 1px solid var(--ln);\n  border-radius: 16px;\n  padding: 18px 20px;\n  display: flex; flex-direction: column; gap: 12px;\n  box-shadow: var(--sh);\n  transition: border-color .2s, transform .2s;\n}\n.gdm-ut-rev:hover { border-color: var(--ln-h); transform: translateY(-2px); }\n.gdm-ut-rev-head { display: flex; align-items: center; gap: 10px; }\n.gdm-ut-av {\n  width: 36px; height: 36px; border-radius: 50%;\n  border: 1px solid var(--ln); overflow: hidden;\n  background: #222; flex-shrink: 0;\n  display: flex; align-items: center; justify-content: center;\n  font-family: 'Barlow Condensed', sans-serif;\n  font-size: 14px; font-weight: 700; color: var(--acc);\n}\n.gdm-ut-av img { width: 100%; height: 100%; object-fit: cover; display: block; }\n.gdm-ut-rev-meta { flex: 1; min-width: 0; }\n.gdm-ut-rev-name { font-size: 13px; font-weight: 600; color: var(--tx); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.gdm-ut-rev-beer { font-size: 10px; color: var(--acc); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }\n.gdm-ut-rev-score {\n  font-family: 'Barlow Condensed', sans-serif;\n  font-size: 19px; font-weight: 800; color: var(--acc); line-height: 1;\n}\n.gdm-ut-rev-score sup { font-size: 10px; color: var(--mu); font-family: 'DM Sans', sans-serif; font-weight: 400; }\n.gdm-ut-rev-quote {\n  font-size: 13px; color: var(--mu);\n  line-height: 1.65; font-style: italic;\n  border-left: 2px solid rgba(255,153,0,0.30);\n  padding-left: 12px; flex: 1;\n}\n \n.gdm-ut-cta-bar {\n  display: flex; align-items: center;\n  justify-content: space-between; gap: 16px;\n  background: radial-gradient(circle at left, rgba(255,153,0,0.07), transparent 60%), var(--c);\n  border: 1px solid var(--ln);\n  border-radius: 16px; padding: 16px 22px; flex-wrap: wrap;\n}\n.gdm-ut-cta-txt { font-size: 13px; color: var(--mu); line-height: 1.6; }\n.gdm-ut-cta-txt strong { color: var(--tx); font-weight: 600; }\n.gdm-ut-cta-actions { display: flex; gap: 10px; flex-shrink: 0; flex-wrap: wrap; }\n.gdm-btn-sm {\n  display: inline-flex; align-items: center; gap: 6px;\n  padding: 9px 18px; border-radius: 999px;\n  font-size: 12.5px; font-weight: 600;\n  border: 1px solid transparent; transition: all .2s;\n  white-space: nowrap; font-family: 'DM Sans', sans-serif;\n}\n.gdm-btn-sm-p { background: var(--acc); color: #0f0f0f; }\n.gdm-btn-sm-p:hover { background: #fff; box-shadow: 0 4px 16px rgba(255,153,0,.30); }\n.gdm-btn-sm-s { background: transparent; color: var(--tx); border-color: var(--ln); }\n.gdm-btn-sm-s:hover { border-color: var(--acc-b); color: var(--acc); background: var(--acc-g); }\n \n@media (max-width: 900px) {\n  .gdm-ut-stats { grid-template-columns: repeat(2, 1fr); }\n  .gdm-ut-reviews { grid-template-columns: repeat(2, 1fr); }\n}\n@media (max-width: 600px) {\n  .gdm-ut-compact { padding: 36px 16px; }\n  .gdm-ut-topbar { flex-direction: column; align-items: flex-start; }\n  .gdm-ut-stats { grid-template-columns: repeat(2, 1fr); }\n  .gdm-ut-reviews { grid-template-columns: 1fr; }\n  .gdm-ut-cta-bar { flex-direction: column; align-items: flex-start; }\n}\n</style>\n \n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n \n<div class=\"gdm-ut-inner\">\n \n  <!-- TOP BAR -->\n  <div class=\"gdm-ut-topbar\">\n    <div class=\"gdm-ut-brand-row\">\n      <a href=\"https://untappd.com/BrasserieLeGueDesMoines\" target=\"_blank\" rel=\"noopener\" class=\"gdm-ut-logo\">\n        <img src=\"https://assets.untappd.com/site/brewery_logos/brewery-270958_04a97.jpeg\" alt=\"Le Gué des Moines sur Untappd\" loading=\"lazy\" width=\"48\" height=\"48\">\n      </a>\n      <div>\n        <div class=\"gdm-ut-eyebrow\">Untappd · Communauté bière</div>\n        <div class=\"gdm-ut-title\">Ce que la communauté dit de nos <em>bières</em></div>\n      </div>\n    </div>\n    <a href=\"https://untappd.com/BrasserieLeGueDesMoines\" target=\"_blank\" rel=\"noopener\" class=\"gdm-ut-profile-link\">\n      Voir le profil ↗\n    </a>\n  </div>\n \n  <!-- STATS -->\n  <div class=\"gdm-ut-stats\">\n    <div class=\"gdm-ut-stat\">\n      <div class=\"gdm-ut-stat-val\">2 245</div>\n      <div class=\"gdm-ut-stat-label\">Check-ins</div>\n    </div>\n    <div class=\"gdm-ut-stat\">\n      <div class=\"gdm-ut-stat-val\">992</div>\n      <div class=\"gdm-ut-stat-label\">Amateurs uniques</div>\n    </div>\n    <div class=\"gdm-ut-stat\">\n      <div class=\"gdm-ut-stat-val\">24</div>\n      <div class=\"gdm-ut-stat-label\">Bières référencées</div>\n    </div>\n    <div class=\"gdm-ut-stat\">\n      <div class=\"gdm-ut-stat-val\">3,66<span style=\"font-size:14px;color:var(--mu);font-weight:400\">/5</span></div>\n      <div class=\"gdm-ut-stat-label\">Note moyenne</div>\n      <div class=\"gdm-stars-sm\" aria-label=\"Note 3,66 sur 5\">\n        <svg viewBox=\"0 0 24 24\" fill=\"#FF9900\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\"/></svg>\n        <svg viewBox=\"0 0 24 24\" fill=\"#FF9900\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\"/></svg>\n        <svg viewBox=\"0 0 24 24\" fill=\"#FF9900\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\"/></svg>\n        <svg viewBox=\"0 0 24 24\">\n          <defs><linearGradient id=\"gdm-hg\" x1=\"0\" x2=\"1\"><stop offset=\"66%\" stop-color=\"#FF9900\"/><stop offset=\"66%\" stop-color=\"rgba(255,255,255,0.15)\"/></linearGradient></defs>\n          <polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\" fill=\"url(#gdm-hg)\"/>\n        </svg>\n        <svg viewBox=\"0 0 24 24\" fill=\"rgba(255,255,255,0.15)\"><polygon points=\"12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26\"/></svg>\n      </div>\n    </div>\n  </div>\n \n  <!-- AVIS -->\n  <div class=\"gdm-ut-reviews\">\n \n    <div class=\"gdm-ut-rev\">\n      <div class=\"gdm-ut-rev-head\">\n        <div class=\"gdm-ut-av\">\n          <img src=\"https://assets.untappd.com/profile/468c53ba583ce3885bb986b488ed9fcc_100x100.jpg\" alt=\"Poulpycole\" loading=\"lazy\" width=\"36\" height=\"36\" onerror=\"this.style.display='none';this.parentElement.textContent='PL'\">\n        </div>\n        <div class=\"gdm-ut-rev-meta\">\n          <div class=\"gdm-ut-rev-name\">Poulpycole</div>\n          <div class=\"gdm-ut-rev-beer\">Série Noire</div>\n        </div>\n        <div class=\"gdm-ut-rev-score\">4,5<sup>/5</sup></div>\n      </div>\n      <div class=\"gdm-ut-rev-quote\">Maltée et tourbée, un côté fruits rouges/noirs (cerise griotte, cassis). Finale et rétro olfaction longue. C'est drôlement bien fait.</div>\n    </div>\n \n    <div class=\"gdm-ut-rev\">\n      <div class=\"gdm-ut-rev-head\">\n        <div class=\"gdm-ut-av\">JO</div>\n        <div class=\"gdm-ut-rev-meta\">\n          <div class=\"gdm-ut-rev-name\">Jbouille Ollivier</div>\n          <div class=\"gdm-ut-rev-beer\">Labelle IPA</div>\n        </div>\n        <div class=\"gdm-ut-rev-score\">4,75<sup>/5</sup></div>\n      </div>\n      <div class=\"gdm-ut-rev-quote\">Très fruité avec un bon goût d'ananas, une bonne amertume. Une IPA bien faite.</div>\n    </div>\n \n    <div class=\"gdm-ut-rev\">\n      <div class=\"gdm-ut-rev-head\">\n        <div class=\"gdm-ut-av\">R</div>\n        <div class=\"gdm-ut-rev-meta\">\n          <div class=\"gdm-ut-rev-name\">Romano</div>\n          <div class=\"gdm-ut-rev-beer\">Roi de Coeur</div>\n        </div>\n        <div class=\"gdm-ut-rev-score\">5,0<sup>/5</sup></div>\n      </div>\n      <div class=\"gdm-ut-rev-quote\">Hé beh pas déçu les copains.</div>\n    </div>\n \n  </div>\n \n  <!-- CTA -->\n  <div class=\"gdm-ut-cta-bar\">\n    <div class=\"gdm-ut-cta-txt\">\n      <strong>Dégustez, notez, partagez sur Untappd</strong><br>\n      Scannez nos étiquettes avec l'app et rejoignez 992 amateurs qui suivent nos bières.\n    </div>\n    <div class=\"gdm-ut-cta-actions\">\n      <a href=\"https://untappd.com/BrasserieLeGueDesMoines\" target=\"_blank\" rel=\"noopener\" class=\"gdm-btn-sm gdm-btn-sm-p\">⭐ Notre profil Untappd</a>\n      <a href=\"/collections/bieres-artisanales-du-gue-des-moines\" class=\"gdm-btn-sm gdm-btn-sm-s\">Nos bières →</a>\n    </div>\n  </div>\n \n</div>\n</section>",
