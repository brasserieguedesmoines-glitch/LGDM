    "custom_liquid_VAEhhd": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<style>\n  :root {\n    --acc: #FF9900;\n    --acc-g: rgba(255,153,0,0.10);\n    --acc-b: rgba(255,153,0,0.28);\n    --c: #161616;\n    --ln: rgba(255,255,255,0.09);\n    --ln-h: rgba(255,153,0,0.35);\n    --tx: #f2f0ec;\n    --mu: rgba(242,240,236,0.72);\n  }\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  .gdm-cr { font-family: 'DM Sans', sans-serif; color: var(--tx); background: transparent; padding: 32px 0; }\n\n  /* Header */\n  .gdm-cr__head {\n    display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;\n  }\n  .gdm-cr__title {\n    font-family: 'Barlow Condensed', sans-serif; font-size: 18px; font-weight: 800;\n    text-transform: uppercase; color: var(--tx);\n  }\n  .gdm-cr__title em { font-style: normal; color: var(--acc); }\n  .gdm-cr__controls { display: flex; align-items: center; gap: 6px; }\n  .gdm-cr__btn {\n    width: 30px; height: 30px; border-radius: 8px;\n    background: var(--c); border: 1px solid var(--ln);\n    color: var(--mu); cursor: pointer; display: flex; align-items: center; justify-content: center;\n    font-size: 13px; transition: border-color .15s, color .15s; user-select: none;\n  }\n  .gdm-cr__btn:hover { border-color: var(--acc-b); color: var(--acc); }\n  .gdm-cr__see-all {\n    font-family: 'Barlow Condensed', sans-serif; font-size: 11px; font-weight: 700;\n    letter-spacing: .06em; text-transform: uppercase;\n    color: var(--mu); text-decoration: none; transition: color .15s; margin-right: 6px;\n  }\n  .gdm-cr__see-all:hover { color: var(--acc); }\n\n  /* Track */\n  .gdm-cr__outer { overflow: hidden; }\n  .gdm-cr__track {\n    display: flex; gap: 8px;\n    transition: transform .35s cubic-bezier(.4,0,.2,1);\n    will-change: transform;\n  }\n\n  /* Carte */\n  .gdm-cr__card {\n    flex: 0 0 calc(25% - 6px);\n    background: var(--c); border: 1px solid var(--ln); border-radius: 13px;\n    text-decoration: none; overflow: hidden; display: flex; flex-direction: column;\n    transition: border-color .2s, transform .2s; position: relative;\n  }\n  .gdm-cr__card::before {\n    content: ''; position: absolute; top: 0; left: 0; right: 0;\n    height: 2px; background: var(--acc); opacity: 0; transition: opacity .2s;\n  }\n  .gdm-cr__card:hover { border-color: var(--ln-h); transform: translateY(-2px); }\n  .gdm-cr__card:hover::before { opacity: 1; }\n\n  /* Image */\n  .gdm-cr__card-img { aspect-ratio: 16/9; overflow: hidden; }\n  .gdm-cr__card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s; }\n  .gdm-cr__card:hover .gdm-cr__card-img img { transform: scale(1.05); }\n\n  /* No-image card */\n  .gdm-cr__card-icon {\n    aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center;\n    font-size: 28px; background: rgba(255,153,0,0.06);\n  }\n\n  /* Body */\n  .gdm-cr__card-body { padding: 11px 13px 13px; flex: 1; display: flex; flex-direction: column; gap: 4px; }\n  .gdm-cr__card-tag {\n    font-family: 'Barlow Condensed', sans-serif; font-size: 9px; font-weight: 700;\n    letter-spacing: .12em; text-transform: uppercase; color: var(--acc);\n  }\n  .gdm-cr__card-title {\n    font-family: 'Barlow Condensed', sans-serif; font-size: 13px; font-weight: 800;\n    text-transform: uppercase; line-height: 1.15; color: var(--tx); flex: 1;\n  }\n  .gdm-cr__card-arr { font-size: 10.5px; color: var(--mu); margin-top: 6px; transition: color .15s; }\n  .gdm-cr__card:hover .gdm-cr__card-arr { color: var(--acc); }\n\n\n  @media (max-width: 768px) {\n    .gdm-cr__card { flex: 0 0 calc(50% - 4px); }\n  }\n  @media (max-width: 480px) {\n    .gdm-cr__card { flex: 0 0 calc(80% - 4px); }\n  }\n</style>\n\n<div class=\"gdm-cr\">\n  <div class=\"gdm-cr__head\">\n    <h2 class=\"gdm-cr__title\">À lire &amp; <em>explorer</em></h2>\n    <div class=\"gdm-cr__controls\">\n      <a href=\"/blogs/infos\" class=\"gdm-cr__see-all\">Tous →</a>\n      <button class=\"gdm-cr__btn\" id=\"gdm-prev\" aria-label=\"Précédent\">‹</button>\n      <button class=\"gdm-cr__btn\" id=\"gdm-next\" aria-label=\"Suivant\">›</button>\n    </div>\n  </div>\n\n  <div class=\"gdm-cr__outer\">\n    <div class=\"gdm-cr__track\" id=\"gdm-track\">\n\n      <a href=\"/blogs/infos/brasserie-artisanale-toulouse\" class=\"gdm-cr__card\">\n        <div class=\"gdm-cr__card-img\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0864/4604/7574/files/BRASSERIE_ARTISANAL_LE_GUE_DES_MOINES_9e8b0033-e237-4d43-a3a0-75f2ece76781.webp?v=1730104704\" alt=\"Brasserie artisanale Toulouse\" loading=\"lazy\">\n        </div>\n        <div class=\"gdm-cr__card-body\">\n          <div class=\"gdm-cr__card-tag\">Guide</div>\n          <div class=\"gdm-cr__card-title\">Brasserie artisanale à Toulouse en 2026</div>\n          <div class=\"gdm-cr__card-arr\">Lire →</div>\n        </div>\n      </a>\n\n      <a href=\"/blogs/infos/location-tireuse-biere-fut-20l-ou-30l-comment-choisir-le-gue-des-moines\" class=\"gdm-cr__card\">\n        <div class=\"gdm-cr__card-img\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0864/4604/7574/files/unnamedLocation_de_tireuse_bi_re_et_f_t_toulouse.jpg?v=1770288654\" alt=\"Location tireuse bière fût Toulouse\" loading=\"lazy\">\n        </div>\n        <div class=\"gdm-cr__card-body\">\n          <div class=\"gdm-cr__card-tag\">Location tireuse</div>\n          <div class=\"gdm-cr__card-title\">Fût 20L ou 30L — comment choisir ?</div>\n          <div class=\"gdm-cr__card-arr\">Lire →</div>\n        </div>\n      </a>\n\n      <a href=\"/blogs/infos/bar-a-biere-artisanale-au-nord-de-toulouse-le-gue-des-moines\" class=\"gdm-cr__card\">\n        <div class=\"gdm-cr__card-img\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0864/4604/7574/files/BRASSERIE_ARTISANAL_LE_GUE_DES_MOINES_3_afb49456-691a-4fb8-97b0-a0b1bbde33ab.webp?v=1730104728\" alt=\"Bar à bière nord Toulouse\" loading=\"lazy\">\n        </div>\n        <div class=\"gdm-cr__card-body\">\n          <div class=\"gdm-cr__card-tag\">Bar &amp; Brewpub</div>\n          <div class=\"gdm-cr__card-title\">Bar à bière artisanale au nord de Toulouse</div>\n          <div class=\"gdm-cr__card-arr\">Lire →</div>\n        </div>\n      </a>\n\n      <a href=\"/blogs/infos/biere-artisanale-pour-un-mariage-ou-un-anniversaire-a-toulouse\" class=\"gdm-cr__card\">\n        <div class=\"gdm-cr__card-img\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0864/4604/7574/files/WhatsApp_Image_2026-04-24_at_08.29.58.jpg?v=1777018896\" alt=\"Bière artisanale mariage anniversaire Toulouse\" loading=\"lazy\">\n        </div>\n        <div class=\"gdm-cr__card-body\">\n          <div class=\"gdm-cr__card-tag\">Événements</div>\n          <div class=\"gdm-cr__card-title\">Bière artisanale pour mariage &amp; anniversaire</div>\n          <div class=\"gdm-cr__card-arr\">Lire →</div>\n        </div>\n      </a>\n\n\n      <a href=\"/blogs/infos/visite-brasserie-artisanale-toulouse\" class=\"gdm-cr__card\">\n        <div class=\"gdm-cr__card-img\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0864/4604/7574/files/BRASSERIE_ARTISANAL_LE_GUE_DES_MOINES_5_1.webp?v=1730113474\" alt=\"Visiter une brasserie artisanale Toulouse\" loading=\"lazy\">\n        </div>\n        <div class=\"gdm-cr__card-body\">\n          <div class=\"gdm-cr__card-tag\">Visite</div>\n          <div class=\"gdm-cr__card-title\">Visiter une brasserie artisanale à Toulouse</div>\n          <div class=\"gdm-cr__card-arr\">Lire →</div>\n        </div>\n      </a>\n\n\n\n    </div>\n  </div>\n\n</div>\n\n<script>\n(function() {\n  const track = document.getElementById('gdm-track');\n  const cards = track.querySelectorAll('.gdm-cr__card');\n  const total = cards.length;\n  let visible = window.innerWidth <= 480 ? 1 : window.innerWidth <= 768 ? 2 : 4;\n  let cur = 0;\n  const max = () => total - visible;\n\n\n  function go(n) {\n    cur = Math.max(0, Math.min(n, max()));\n    const w = cards[0].getBoundingClientRect().width + 8;\n    track.style.transform = `translateX(-${cur * w}px)`;\n  }\n\n  document.getElementById('gdm-prev').addEventListener('click', () => go(cur - visible));\n  document.getElementById('gdm-next').addEventListener('click', () => go(cur + visible));\n\n  // Touch swipe\n  let startX = 0;\n  track.addEventListener('touchstart', e => startX = e.touches[0].clientX, { passive: true });\n  track.addEventListener('touchend', e => {\n    const dx = startX - e.changedTouches[0].clientX;\n    if (Math.abs(dx) > 40) go(dx > 0 ? cur + 1 : cur - 1);\n  });\n\n  window.addEventListener('resize', () => {\n    visible = window.innerWidth <= 480 ? 1 : window.innerWidth <= 768 ? 2 : 4;\n    go(0);\n  });\n\n})();\n</script>",
