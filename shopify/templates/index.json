      "settings": {
        "custom_liquid": "<section class=\"gdmr\" aria-label=\"Avis clients — Le Gué des Moines\">\n<style>\n.gdmr {\n  --acc: #FF9900;\n  --acc-g: rgba(255,153,0,0.10);\n  --acc-b: rgba(255,153,0,0.28);\n  --c: #161616;\n  --ln: rgba(255,255,255,0.09);\n  --ln-h: rgba(255,153,0,0.35);\n  --tx: #f2f0ec;\n  --mu: rgba(242,240,236,0.68);\n  --sh: 0 12px 36px rgba(0,0,0,0.36);\n  background: transparent;\n  color: var(--tx);\n  padding: 56px 20px;\n  font-family: 'DM Sans', sans-serif;\n  position: relative;\n}\n.gdmr * { box-sizing: border-box; margin: 0; padding: 0; }\n \n.gdmr__wrap { max-width: 1180px; margin: 0 auto; }\n \n/* ── HEADER ── */\n.gdmr__head {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 20px;\n  margin-bottom: 28px;\n  flex-wrap: wrap;\n}\n.gdmr__kicker {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  background: var(--acc-g);\n  border: 1px solid var(--acc-b);\n  color: #ffc966;\n  padding: 5px 13px;\n  border-radius: 999px;\n  font-size: 10.5px;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  margin-bottom: 14px;\n}\n.gdmr__kicker-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--acc); }\n.gdmr__title {\n  font-family: 'Barlow Condensed', sans-serif;\n  font-size: clamp(28px, 4vw, 44px);\n  font-weight: 800;\n  text-transform: uppercase;\n  line-height: 1.0;\n  letter-spacing: -0.01em;\n  color: var(--tx);\n  margin-bottom: 6px;\n}\n.gdmr__title em { font-style: normal; color: var(--acc); }\n.gdmr__subtitle { font-size: 13.5px; color: var(--mu); }\n \n/* Boutons nav */\n.gdmr__nav { display: flex; gap: 8px; align-items: center; flex-shrink: 0; }\n.gdmr__btn {\n  width: 42px; height: 42px;\n  border-radius: 50%;\n  background: var(--c);\n  border: 1px solid var(--ln);\n  color: var(--tx);\n  cursor: pointer;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 18px; line-height: 1;\n  transition: border-color 0.2s, background 0.2s, transform 0.2s;\n  font-family: 'DM Sans', sans-serif;\n}\n.gdmr__btn:hover {\n  border-color: var(--acc-b);\n  color: var(--acc);\n  background: var(--acc-g);\n  transform: translateY(-1px);\n}\n.gdmr__btn:disabled { opacity: 0.3; cursor: not-allowed; transform: none; }\n \n/* ── STAT GLOBALE ── */\n.gdmr__global {\n  display: flex;\n  align-items: center;\n  gap: 28px;\n  background: var(--c);\n  border: 1px solid var(--ln);\n  border-radius: 16px;\n  padding: 16px 24px;\n  margin-bottom: 20px;\n  flex-wrap: wrap;\n}\n.gdmr__global-score {\n  display: flex;\n  align-items: baseline;\n  gap: 6px;\n}\n.gdmr__score-big {\n  font-family: 'Barlow Condensed', sans-serif;\n  font-size: 48px;\n  font-weight: 800;\n  color: var(--acc);\n  line-height: 1;\n}\n.gdmr__score-max { font-size: 18px; color: var(--mu); }\n.gdmr__global-stars {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.gdmr__stars { display: flex; gap: 3px; }\n.gdmr__star { font-size: 16px; color: var(--acc); }\n.gdmr__star--empty { color: rgba(255,255,255,0.2); }\n.gdmr__star-count { font-size: 12px; color: var(--mu); }\n.gdmr__global-sep {\n  width: 1px;\n  height: 40px;\n  background: var(--ln);\n  flex-shrink: 0;\n}\n.gdmr__global-badges { display: flex; gap: 10px; flex-wrap: wrap; }\n.gdmr__badge {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: 8px 16px;\n  background: rgba(255,255,255,0.03);\n  border: 1px solid var(--ln);\n  border-radius: 10px;\n}\n.gdmr__badge-val {\n  font-family: 'Barlow Condensed', sans-serif;\n  font-size: 22px;\n  font-weight: 800;\n  color: var(--tx);\n  line-height: 1;\n}\n.gdmr__badge-lbl { font-size: 10px; color: var(--mu); margin-top: 2px; }\n.gdmr__global-cta {\n  margin-left: auto;\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  padding: 10px 20px;\n  border-radius: 999px;\n  background: var(--acc);\n  color: #0f0f0f;\n  font-size: 13px;\n  font-weight: 600;\n  font-family: 'DM Sans', sans-serif;\n  text-decoration: none;\n  transition: background 0.2s, transform 0.2s;\n  white-space: nowrap;\n}\n.gdmr__global-cta:hover { background: #fff; transform: translateY(-1px); }\n \n/* ── CAROUSEL ── */\n.gdmr__viewport {\n  overflow: hidden;\n  position: relative;\n  border-radius: 16px;\n  outline: none;\n}\n.gdmr__track {\n  display: flex;\n  gap: 12px;\n  list-style: none;\n  padding: 6px 2px 14px;\n  overflow-x: auto;\n  scroll-snap-type: x mandatory;\n  -webkit-overflow-scrolling: touch;\n  scrollbar-width: none;\n}\n.gdmr__track::-webkit-scrollbar { display: none; }\n \n/* ── CARD AVIS ── */\n.gdmr__card {\n  scroll-snap-align: start;\n  flex: 0 0 clamp(260px, 30vw, 340px);\n  background: var(--c);\n  border: 1px solid var(--ln);\n  border-radius: 18px;\n  padding: 20px;\n  box-shadow: var(--sh);\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  position: relative;\n  overflow: hidden;\n  transition: border-color 0.2s, transform 0.2s;\n}\n.gdmr__card:hover { border-color: var(--ln-h); transform: translateY(-2px); }\n \n/* Trait amber haut de card */\n.gdmr__card::before {\n  content: '';\n  position: absolute;\n  top: 0; left: 20px; right: 20px;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, rgba(255,153,0,0.5), transparent);\n}\n \n.gdmr__card-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n}\n.gdmr__card-stars { display: flex; gap: 2px; }\n.gdmr__card-stars span { font-size: 13px; color: var(--acc); }\n.gdmr__card-tag {\n  font-size: 10.5px;\n  font-weight: 600;\n  padding: 4px 10px;\n  border-radius: 999px;\n  background: var(--acc-g);\n  border: 1px solid var(--acc-b);\n  color: #ffc966;\n  white-space: nowrap;\n  letter-spacing: 0.04em;\n}\n \n.gdmr__card-text {\n  font-size: 14px;\n  color: var(--tx);\n  line-height: 1.68;\n  flex: 1;\n  font-style: italic;\n  border-left: 2px solid rgba(255,153,0,0.28);\n  padding-left: 12px;\n}\n \n.gdmr__card-meta {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding-top: 10px;\n  border-top: 1px solid var(--ln);\n}\n.gdmr__card-avatar {\n  width: 32px; height: 32px;\n  border-radius: 50%;\n  background: rgba(255,153,0,0.12);\n  border: 1px solid var(--acc-b);\n  display: flex; align-items: center; justify-content: center;\n  font-family: 'Barlow Condensed', sans-serif;\n  font-size: 13px;\n  font-weight: 700;\n  color: var(--acc);\n  flex-shrink: 0;\n}\n.gdmr__card-info { display: flex; flex-direction: column; gap: 1px; }\n.gdmr__card-name { font-size: 13px; font-weight: 600; color: var(--tx); }\n.gdmr__card-place { font-size: 11px; color: var(--mu); }\n \n/* Fades latéraux */\n.gdmr__fade {\n  position: absolute;\n  top: 0; bottom: 0;\n  width: 48px;\n  pointer-events: none;\n  z-index: 5;\n}\n.gdmr__fade--l {\n  left: 0;\n  background: linear-gradient(90deg, #0f0f0f, transparent);\n}\n.gdmr__fade--r {\n  right: 0;\n  background: linear-gradient(270deg, #0f0f0f, transparent);\n}\n \n/* Dots de pagination */\n.gdmr__dots {\n  display: flex;\n  justify-content: center;\n  gap: 6px;\n  margin-top: 16px;\n}\n.gdmr__dot {\n  width: 6px; height: 6px;\n  border-radius: 50%;\n  background: var(--ln);\n  transition: background 0.2s, width 0.2s;\n  cursor: pointer;\n  border: none;\n  padding: 0;\n}\n.gdmr__dot.active {\n  background: var(--acc);\n  width: 20px;\n  border-radius: 3px;\n}\n \n/* ── RESPONSIVE ── */\n@media (max-width: 640px) {\n  .gdmr { padding: 40px 16px; }\n  .gdmr__head { align-items: flex-start; }\n  .gdmr__nav { display: none; }\n  .gdmr__global-cta { width: 100%; justify-content: center; margin-left: 0; }\n  .gdmr__global { gap: 16px; }\n}\n</style>\n \n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n \n<div class=\"gdmr__wrap\">\n \n  <!-- HEADER -->\n  <div class=\"gdmr__head\">\n    <div>\n      <p class=\"gdmr__kicker\"><span class=\"gdmr__kicker-dot\"></span> Avis clients vérifiés</p>\n      <h2 class=\"gdmr__title\">Ils parlent du<br><em>Gué des Moines</em></h2>\n      <p class=\"gdmr__subtitle\">Bière artisanale · Brewpub · Événements · Bruguières (près de Toulouse)</p>\n    </div>\n    <div class=\"gdmr__nav\">\n      <button class=\"gdmr__btn gdmr__prev\" type=\"button\" aria-label=\"Avis précédent\">‹</button>\n      <button class=\"gdmr__btn gdmr__next\" type=\"button\" aria-label=\"Avis suivant\">›</button>\n    </div>\n  </div>\n \n  <!-- STAT GLOBALE -->\n  <div class=\"gdmr__global\">\n    <div class=\"gdmr__global-score\">\n      <span class=\"gdmr__score-big\">5,0</span>\n      <span class=\"gdmr__score-max\">/5</span>\n    </div>\n    <div class=\"gdmr__global-stars\">\n      <div class=\"gdmr__stars\" aria-label=\"5 étoiles sur 5\">\n        <span class=\"gdmr__star\">★</span>\n        <span class=\"gdmr__star\">★</span>\n        <span class=\"gdmr__star\">★</span>\n        <span class=\"gdmr__star\">★</span>\n        <span class=\"gdmr__star\">★</span>\n      </div>\n      <span class=\"gdmr__star-count\">Avis 5 étoiles · Google & sur place</span>\n    </div>\n    <div class=\"gdmr__global-sep\"></div>\n    <div class=\"gdmr__global-badges\">\n      <div class=\"gdmr__badge\">\n        <span class=\"gdmr__badge-val\">100%</span>\n        <span class=\"gdmr__badge-lbl\">Artisanal</span>\n      </div>\n      <div class=\"gdmr__badge\">\n        <span class=\"gdmr__badge-val\">+10</span>\n        <span class=\"gdmr__badge-lbl\">Bières pression</span>\n      </div>\n      <div class=\"gdmr__badge\">\n        <span class=\"gdmr__badge-val\">2016</span>\n        <span class=\"gdmr__badge-lbl\">Fondée</span>\n      </div>\n    </div>\n    <a href=\"https://www.google.com/search?q=Le+Gué+des+Moines+Bruguières+avis\" target=\"_blank\" rel=\"noopener\" class=\"gdmr__global-cta\">\n      Laisser un avis Google ↗\n    </a>\n  </div>\n \n  <!-- CAROUSEL -->\n  <div class=\"gdmr__viewport\" tabindex=\"0\" aria-roledescription=\"carousel\" aria-label=\"Carrousel d'avis clients\">\n    <ul class=\"gdmr__track\" role=\"list\">\n \n      <li class=\"gdmr__card\" role=\"listitem\">\n        <div class=\"gdmr__card-top\">\n          <div class=\"gdmr__card-stars\" aria-label=\"5 étoiles sur 5\">\n            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>\n          </div>\n          <span class=\"gdmr__card-tag\">Google</span>\n        </div>\n        <p class=\"gdmr__card-text\">Ambiance au top, bières excellentes et équipe super accueillante. Un vrai spot près de Toulouse.</p>\n        <div class=\"gdmr__card-meta\">\n          <div class=\"gdmr__card-avatar\">C</div>\n          <div class=\"gdmr__card-info\">\n            <span class=\"gdmr__card-name\">Camille</span>\n            <span class=\"gdmr__card-place\">Brewpub · Bruguières</span>\n          </div>\n        </div>\n      </li>\n \n      <li class=\"gdmr__card\" role=\"listitem\">\n        <div class=\"gdmr__card-top\">\n          <div class=\"gdmr__card-stars\" aria-label=\"5 étoiles sur 5\">\n            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>\n          </div>\n          <span class=\"gdmr__card-tag\">Sur place</span>\n        </div>\n        <p class=\"gdmr__card-text\">Grand choix de bières artisanales, planches parfaites, lieu convivial. On revient souvent.</p>\n        <div class=\"gdmr__card-meta\">\n          <div class=\"gdmr__card-avatar\">J</div>\n          <div class=\"gdmr__card-info\">\n            <span class=\"gdmr__card-name\">Julien</span>\n            <span class=\"gdmr__card-place\">Client fidèle · Bruguières</span>\n          </div>\n        </div>\n      </li>\n \n      <li class=\"gdmr__card\" role=\"listitem\">\n        <div class=\"gdmr__card-top\">\n          <div class=\"gdmr__card-stars\" aria-label=\"5 étoiles sur 5\">\n            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>\n          </div>\n          <span class=\"gdmr__card-tag\">Location tireuse</span>\n        </div>\n        <p class=\"gdmr__card-text\">Location de tireuse impeccable pour notre anniversaire. Fût 20L, mise en service rapide. Je recommande !</p>\n        <div class=\"gdmr__card-meta\">\n          <div class=\"gdmr__card-avatar\">S</div>\n          <div class=\"gdmr__card-info\">\n            <span class=\"gdmr__card-name\">Sophie</span>\n            <span class=\"gdmr__card-place\">Événement privé · Toulouse (31)</span>\n          </div>\n        </div>\n      </li>\n \n      <li class=\"gdmr__card\" role=\"listitem\">\n        <div class=\"gdmr__card-top\">\n          <div class=\"gdmr__card-stars\" aria-label=\"5 étoiles sur 5\">\n            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>\n          </div>\n          <span class=\"gdmr__card-tag\">Coup de cœur</span>\n        </div>\n        <p class=\"gdmr__card-text\">Bières locales de grande qualité, service chaleureux, cadre canon. Mention spéciale aux nouveautés éphémères.</p>\n        <div class=\"gdmr__card-meta\">\n          <div class=\"gdmr__card-avatar\">M</div>\n          <div class=\"gdmr__card-info\">\n            <span class=\"gdmr__card-name\">Mathieu</span>\n            <span class=\"gdmr__card-place\">Amateur de bière artisanale</span>\n          </div>\n        </div>\n      </li>\n \n      <li class=\"gdmr__card\" role=\"listitem\">\n        <div class=\"gdmr__card-top\">\n          <div class=\"gdmr__card-stars\" aria-label=\"5 étoiles sur 5\">\n            <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>\n          </div>\n          <span class=\"gdmr__card-tag\">Événement pro</span>\n        </div>\n        <p class=\"gdmr__card-text\">Service pro, super conseils pour choisir les fûts 20L/30L. Installation simple et efficace pour notre afterwork.</p>\n        <div class=\"gdmr__card-meta\">\n          <div class=\"gdmr__card-avatar\">N</div>\n          <div class=\"gdmr__card-info\">\n            <span class=\"gdmr__card-name\">Nicolas</span>\n            <span class=\"gdmr__card-place\">Événement entreprise · Toulouse</span>\n          </div>\n        </div>\n      </li>\n \n    </ul>\n \n    <div class=\"gdmr__fade gdmr__fade--l\" aria-hidden=\"true\"></div>\n    <div class=\"gdmr__fade gdmr__fade--r\" aria-hidden=\"true\"></div>\n  </div>\n \n  <!-- DOTS -->\n  <div class=\"gdmr__dots\" role=\"tablist\" aria-label=\"Navigation des avis\">\n    <button class=\"gdmr__dot active\" role=\"tab\" aria-label=\"Avis 1\" aria-selected=\"true\"></button>\n    <button class=\"gdmr__dot\" role=\"tab\" aria-label=\"Avis 2\" aria-selected=\"false\"></button>\n    <button class=\"gdmr__dot\" role=\"tab\" aria-label=\"Avis 3\" aria-selected=\"false\"></button>\n    <button class=\"gdmr__dot\" role=\"tab\" aria-label=\"Avis 4\" aria-selected=\"false\"></button>\n    <button class=\"gdmr__dot\" role=\"tab\" aria-label=\"Avis 5\" aria-selected=\"false\"></button>\n  </div>\n \n</div>\n</section>\n \n<script>\n(function () {\n  const root = document.querySelector('.gdmr');\n  if (!root) return;\n \n  const track   = root.querySelector('.gdmr__track');\n  const cards   = Array.from(root.querySelectorAll('.gdmr__card'));\n  const prev    = root.querySelector('.gdmr__prev');\n  const next    = root.querySelector('.gdmr__next');\n  const dots    = Array.from(root.querySelectorAll('.gdmr__dot'));\n  const viewport = root.querySelector('.gdmr__viewport');\n \n  if (!track || cards.length === 0) return;\n \n  const gap  = () => parseFloat(getComputedStyle(track).gap || '12');\n  const step = () => cards[0].getBoundingClientRect().width + gap();\n \n  let current = 0;\n \n  const scrollTo = (idx) => {\n    current = Math.max(0, Math.min(idx, cards.length - 1));\n    track.scrollTo({ left: current * step(), behavior: 'smooth' });\n    updateUI();\n  };\n \n  const updateUI = () => {\n    const maxScroll = track.scrollWidth - track.clientWidth - 2;\n    if (prev) prev.disabled = current <= 0;\n    if (next) next.disabled = current >= cards.length - 1;\n    dots.forEach((d, i) => {\n      d.classList.toggle('active', i === current);\n      d.setAttribute('aria-selected', i === current ? 'true' : 'false');\n    });\n  };\n \n  if (prev) prev.addEventListener('click', () => { scrollTo(current - 1); restart(); });\n  if (next) next.addEventListener('click', () => { scrollTo(current + 1); restart(); });\n \n  dots.forEach((d, i) => d.addEventListener('click', () => { scrollTo(i); restart(); }));\n \n  if (viewport) {\n    viewport.addEventListener('keydown', (e) => {\n      if (e.key === 'ArrowLeft')  { scrollTo(current - 1); restart(); }\n      if (e.key === 'ArrowRight') { scrollTo(current + 1); restart(); }\n    });\n  }\n \n  track.addEventListener('scroll', () => {\n    const s = step();\n    if (s > 0) current = Math.round(track.scrollLeft / s);\n    updateUI();\n  }, { passive: true });\n \n  // Autoplay\n  let timer = null;\n  const start = () => {\n    stop();\n    timer = setInterval(() => {\n      scrollTo(current >= cards.length - 1 ? 0 : current + 1);\n    }, 6000);\n  };\n  const stop = () => { clearInterval(timer); timer = null; };\n  const restart = () => start();\n \n  root.addEventListener('mouseenter', stop);\n  root.addEventListener('mouseleave', start);\n \n  updateUI();\n  start();\n})();\n</script>",
