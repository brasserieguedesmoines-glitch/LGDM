    "custom_liquid_MfL7Kf": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "<section class=\"gdm-tireuse\" aria-label=\"Location de tireuse à bière à Toulouse\">\n<style>\n.gdm-tireuse {\n  --acc: #FF9900;\n  --acc-g: rgba(255,153,0,0.10);\n  --acc-b: rgba(255,153,0,0.28);\n  --c: #161616;\n  --ln: rgba(255,255,255,0.09);\n  --ln-h: rgba(255,153,0,0.35);\n  --tx: #f2f0ec;\n  --mu: rgba(242,240,236,0.68);\n  background: transparent;\n  color: var(--tx);\n  padding: 48px 20px;\n  font-family: 'DM Sans', sans-serif;\n}\n.gdm-tireuse * { box-sizing: border-box; margin: 0; padding: 0; }\n.gdm-tireuse a { text-decoration: none; color: inherit; }\n \n/* ── GRID ── */\n.gdm-tr-grid {\n  max-width: 1180px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 48px;\n  align-items: center;\n}\n \n/* ── IMAGE ── */\n.gdm-tr-visual {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n \n \n \n.gdm-tr-img {\n  position: relative;\n  z-index: 1;\n  width: 100%;\n  height: auto;\n  display: block;\n  border: none;\n  outline: none;\n  /* Image qui ressort : ombre portée ambrée */\n  filter: drop-shadow(0 24px 48px rgba(0,0,0,0.55));\n  transition: filter 0.4s ease, transform 0.4s ease;\n}\n.gdm-tireuse:hover .gdm-tr-img {\n  filter: drop-shadow(0 32px 56px rgba(0,0,0,0.65));\n  transform: translateY(-4px);\n}\n \n/* Stats flottantes sur l'image */\n.gdm-tr-stats {\n  position: absolute;\n  bottom: -8px;\n  left: 0;\n  right: 0;\n  z-index: 2;\n  display: flex;\n  justify-content: center;\n  gap: 10px;\n}\n.gdm-tr-stat {\n  background: rgba(22,22,22,0.88);\n  border: 1px solid var(--ln-h);\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n  border-radius: 12px;\n  padding: 10px 16px;\n  text-align: center;\n}\n.gdm-tr-stat-val {\n  font-family: 'Barlow Condensed', sans-serif;\n  font-size: 20px;\n  font-weight: 800;\n  color: var(--acc);\n  line-height: 1;\n  margin-bottom: 2px;\n}\n.gdm-tr-stat-lbl { font-size: 10px; color: var(--mu); }\n \n/* ── CONTENU DROITE ── */\n.gdm-tr-content {\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n}\n \n.gdm-tr-kicker {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  background: var(--acc-g);\n  border: 1px solid var(--acc-b);\n  color: #ffc966;\n  padding: 6px 14px;\n  border-radius: 999px;\n  font-size: 10.5px;\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  margin-bottom: 20px;\n  align-self: flex-start;\n}\n.gdm-tr-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--acc); }\n \n.gdm-tr-h2 {\n  font-family: 'Barlow Condensed', sans-serif;\n  font-size: clamp(34px, 4vw, 54px);\n  font-weight: 800;\n  text-transform: uppercase;\n  line-height: 1.0;\n  letter-spacing: -0.01em;\n  margin-bottom: 18px;\n  color: var(--tx);\n}\n.gdm-tr-h2 em { font-style: normal; color: var(--acc); }\n \n.gdm-tr-desc {\n  font-size: 15px;\n  color: var(--mu);\n  line-height: 1.75;\n  margin-bottom: 24px;\n}\n.gdm-tr-desc strong { color: var(--tx); font-weight: 600; }\n \n/* Événements */\n.gdm-tr-events {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 7px;\n  margin-bottom: 24px;\n}\n.gdm-tr-event {\n  padding: 6px 12px;\n  background: rgba(255,255,255,0.04);\n  border: 1px solid var(--ln);\n  border-radius: 999px;\n  font-size: 12px;\n  color: var(--mu);\n  font-weight: 500;\n  transition: border-color 0.2s, color 0.2s;\n}\n.gdm-tr-event:hover { border-color: var(--acc-b); color: var(--acc); }\n \n/* Fûts */\n.gdm-tr-futs {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 10px;\n  margin-bottom: 28px;\n}\n.gdm-tr-fut {\n  background: var(--c);\n  border: 1px solid var(--ln);\n  border-radius: 14px;\n  padding: 14px 16px;\n  transition: border-color 0.2s;\n}\n.gdm-tr-fut:hover { border-color: var(--ln-h); }\n.gdm-tr-fut-val {\n  font-family: 'Barlow Condensed', sans-serif;\n  font-size: 22px; font-weight: 800;\n  color: var(--acc); line-height: 1; margin-bottom: 3px;\n}\n.gdm-tr-fut-lbl { font-size: 11px; color: var(--mu); }\n \n/* CTAs */\n.gdm-tr-actions { display: flex; flex-wrap: wrap; gap: 12px; }\n.gdm-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-height: 50px;\n  padding: 0 26px;\n  border-radius: 999px;\n  font-size: 14.5px;\n  font-weight: 600;\n  border: 1px solid transparent;\n  transition: all 0.22s ease;\n  font-family: 'DM Sans', sans-serif;\n  white-space: nowrap;\n}\n.gdm-btn-p { background: var(--acc); color: #0f0f0f; }\n.gdm-btn-p:hover { background: #fff; transform: translateY(-2px); box-shadow: 0 6px 24px rgba(255,153,0,0.35); }\n.gdm-btn-s { background: transparent; color: var(--tx); border-color: var(--ln); }\n.gdm-btn-s:hover { border-color: var(--acc-b); color: var(--acc); background: var(--acc-g); }\n \n/* ── RESPONSIVE ── */\n@media (max-width: 860px) {\n  .gdm-tr-grid {\n    grid-template-columns: 1fr;\n    gap: 32px;\n  }\n  .gdm-tr-visual { max-width: 480px; margin: 0 auto; }\n  .gdm-tr-stats { bottom: -12px; }\n}\n@media (max-width: 480px) {\n  .gdm-tireuse { padding: 36px 16px; }\n  .gdm-tr-actions { flex-direction: column; }\n  .gdm-btn { width: 100%; }\n}\n</style>\n \n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n \n<div class=\"gdm-tr-grid\">\n \n  <!-- VISUEL -->\n  <div class=\"gdm-tr-visual\">\n    <img\n      class=\"gdm-tr-img\"\n      src=\"https://cdn.shopify.com/s/files/1/0864/4604/7574/files/LOCATION_DE_TIREUSE_TOULOUSE.webp?v=1729678213\"\n      alt=\"Location tireuse à bière artisanale pour événements à Toulouse — Le Gué des Moines\"\n      loading=\"lazy\"\n      width=\"800\"\n      height=\"700\"\n    >\n \n    <div class=\"gdm-tr-stats\">\n      <div class=\"gdm-tr-stat\">\n        <div class=\"gdm-tr-stat-val\">20L</div>\n        <div class=\"gdm-tr-stat-lbl\">60–70 verres</div>\n      </div>\n      <div class=\"gdm-tr-stat\">\n        <div class=\"gdm-tr-stat-val\">30L</div>\n        <div class=\"gdm-tr-stat-lbl\">90–110 verres</div>\n      </div>\n      <div class=\"gdm-tr-stat\">\n        <div class=\"gdm-tr-stat-val\">100%</div>\n        <div class=\"gdm-tr-stat-lbl\">Artisanal</div>\n      </div>\n    </div>\n  </div>\n \n  <!-- CONTENU -->\n  <div class=\"gdm-tr-content\">\n \n    <div class=\"gdm-tr-kicker\">\n      <span class=\"gdm-tr-dot\"></span>\n      Location · Tireuse · Fûts · Toulouse (31)\n    </div>\n \n    <h2 class=\"gdm-tr-h2\">\n      Location de<br>tireuse à bière<br>à <em>Toulouse</em>\n    </h2>\n \n    <p class=\"gdm-tr-desc\">\n      Vous organisez un événement et souhaitez proposer une <strong>bière artisanale locale</strong> à vos invités ?\n      Le Gué des Moines, brasserie à <strong>Bruguières près de Toulouse</strong>,\n      propose la vente de fûts et la <strong>location de tireuse à bière</strong>\n      pour tous vos événements en Haute-Garonne.\n    </p>\n \n    <div class=\"gdm-tr-events\">\n      <span class=\"gdm-tr-event\">💍 Mariage</span>\n      <span class=\"gdm-tr-event\">🎂 Anniversaire</span>\n      <span class=\"gdm-tr-event\">🏢 Entreprise</span>\n      <span class=\"gdm-tr-event\">🎪 Association</span>\n      <span class=\"gdm-tr-event\">🎊 Soirée privée</span>\n    </div>\n \n    <div class=\"gdm-tr-futs\">\n      <div class=\"gdm-tr-fut\">\n        <div class=\"gdm-tr-fut-val\">Fût 20L</div>\n        <div class=\"gdm-tr-fut-lbl\">Petits événements</div>\n      </div>\n      <div class=\"gdm-tr-fut\">\n        <div class=\"gdm-tr-fut-val\">Fût 30L</div>\n        <div class=\"gdm-tr-fut-lbl\">Grands événements</div>\n      </div>\n    </div>\n \n    <div class=\"gdm-tr-actions\">\n      <a href=\"/pages/location-de-tireuse-toulouse-31\" class=\"gdm-btn gdm-btn-p\">\n        Réservez ma tireuse →\n      </a>\n      <a href=\"/pages/contact\" class=\"gdm-btn gdm-btn-s\">\n        Demander un devis\n  