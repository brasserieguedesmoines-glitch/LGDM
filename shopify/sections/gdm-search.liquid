    },
    {
      "type": "text",
      "id": "label_soldout",
      "label": "Épuisée",
      "default": "Épuisée"
    },
    {
      "type": "text",
      "id": "label_sale",
      "label": "Promotion",
      "default": "Promo"
    },
    {
      "type": "text",
      "id": "label_from",
      "label": "Prix minimum",
      "default": "dès"
    },
    {
      "type": "text",
      "id": "label_bitterness",
      "label": "Amertume",
      "default": "Amertume"
    },
    {
      "type": "text",
      "id": "label_format",
      "label": "Contenant",
      "default": "Contenant"
    },
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond",
      "default": "#0D0D0D"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#F0921E"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "GDM · Recherche"
    }
  ],
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}
