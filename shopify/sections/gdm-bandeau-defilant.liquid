{%- comment -%}
  Le Gué des Moines — Bandeau défilant
  Texte géant qui défile en continu, séparé par des icônes (houblon, étoile…).
  Option « bandeaux croisés » pour un effet affiche de concert.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign direction = 'normal'
  if s.direction == 'right'
    assign direction = 'reverse'
  endif
-%}
{%- render 'gdm-assets' -%}

{%- comment -%}
  Passage 1 : bandeau principal (lisible, liens actifs).
  Passage 2 : bandeau décoratif de l'option « croisés » (masqué aux lecteurs d'écran).
  Chaque bandeau contient 2 copies × 3 répétitions pour boucler sans trou.
{%- endcomment -%}
{%- for pass in (1..2) -%}
  {%- if pass == 2 and s.layout != 'crossed' -%}{%- break -%}{%- endif -%}
  {%- capture band_items -%}
    {%- for copy in (1..2) -%}
      <ul class="gdm-marquee__group"{% if copy == 2 or pass == 2 %} aria-hidden="true"{% endif %}>
        {%- for repeat in (1..3) -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign readable = false
              if pass == 1 and copy == 1 and repeat == 1
                assign readable = true
              endif
              assign is_outline = false
              if s.style == 'outline'
                assign is_outline = true
              elsif s.style == 'mixed'
                assign odd = forloop.index | modulo: 2
                if odd == 0
                  assign is_outline = true
                endif
              endif
            -%}
            <li class="gdm-marquee__item"{% if readable %} {{ block.shopify_attributes }}{% else %} aria-hidden="true"{% endif %}>
              {%- if block.settings.link != blank and readable -%}
                <a class="gdm-marquee__text{% if is_outline %} is-outline{% endif %}" href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
              {%- else -%}
                <span class="gdm-marquee__text{% if is_outline %} is-outline{% endif %}">{{ block.settings.text | escape }}</span>
              {%- endif -%}
              <span class="gdm-marquee__sep">{% render 'gdm-icon', name: s.separator %}</span>
            </li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  {%- endcapture -%}
  {%- if pass == 1 -%}
    {%- assign band_front = band_items -%}
  {%- else -%}
    {%- assign band_back = band_items -%}
  {%- endif -%}
{%- endfor -%}

<gdm-section
  id="gdm-{{ section.id }}"
  class="gdm gdm-marquee gdm-marquee--{{ s.size }} gdm-marquee--{{ s.layout }}"
  style="--gdm-bg: {{ s.color_bg }}; --gdm-accent: {{ s.color_accent }}; --gdm-speed: {{ s.speed }}s; --gdm-dir: {{ direction }}; --gdm-pt: {{ s.padding_top }}px; --gdm-pb: {{ s.padding_bottom }}px;"
>
  {%- if section.blocks.size > 0 -%}
    {%- if s.layout == 'crossed' -%}
      <div class="gdm-marquee__band gdm-marquee__band--back" aria-hidden="true">
        <div class="gdm-marquee__track">{{ band_back }}</div>
      </div>
    {%- endif -%}
    <div class="gdm-marquee__band gdm-marquee__band--{{ s.band_style }}">
      <div class="gdm-marquee__track">{{ band_front }}</div>
    </div>
  {%- endif -%}
</gdm-section>

{% stylesheet %}
  .gdm.gdm-marquee {
    --gdm-marquee-size: clamp(34px, 22px + 3vw, 64px);
    display: grid;
  }

  .gdm.gdm-marquee--small {
    --gdm-marquee-size: clamp(22px, 18px + 1vw, 32px);
  }

  .gdm.gdm-marquee--large {
    --gdm-marquee-size: clamp(48px, 24px + 6vw, 120px);
  }

  .gdm.gdm-marquee .gdm-marquee__band {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    padding-block: calc(var(--gdm-marquee-size) * 0.32);
    border-block: 1px solid var(--gdm-border);
    background: var(--gdm-bg);
    overflow: hidden;
  }

  .gdm.gdm-marquee .gdm-marquee__band--accent {
    border-color: transparent;
    background: var(--gdm-accent);
    color: var(--gdm-on-accent);
  }

  .gdm.gdm-marquee .gdm-marquee__band--surface {
    background: var(--gdm-surface);
  }

  .gdm.gdm-marquee .gdm-marquee__track {
    display: flex;
    width: max-content;
    animation: gdm-marquee var(--gdm-speed, 30s) linear infinite;
    animation-direction: var(--gdm-dir, normal);
  }

  .gdm.gdm-marquee:hover .gdm-marquee__track {
    animation-play-state: paused;
  }

  .gdm.gdm-marquee .gdm-marquee__group {
    display: flex;
    flex: none;
    align-items: center;
  }

  .gdm.gdm-marquee .gdm-marquee__item {
    display: flex;
    flex: none;
    align-items: center;
  }

  .gdm.gdm-marquee .gdm-marquee__text {
    font-family: var(--gdm-font-display);
    font-size: var(--gdm-marquee-size);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    color: inherit;
    transition: color 0.2s var(--gdm-ease);
  }

  .gdm.gdm-marquee a.gdm-marquee__text:hover {
    color: var(--gdm-accent);
  }

  .gdm.gdm-marquee .gdm-marquee__text.is-outline {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--gdm-text);
  }

  .gdm.gdm-marquee .gdm-marquee__band--accent .gdm-marquee__text.is-outline {
    -webkit-text-stroke-color: var(--gdm-on-accent);
  }

  .gdm.gdm-marquee .gdm-marquee__sep {
    display: grid;
    place-items: center;
    margin-inline: calc(var(--gdm-marquee-size) * 0.45);
    color: var(--gdm-accent);
  }

  .gdm.gdm-marquee .gdm-marquee__band--accent .gdm-marquee__sep {
    color: var(--gdm-on-accent);
  }

  .gdm.gdm-marquee .gdm-marquee__sep svg {
    width: calc(var(--gdm-marquee-size) * 0.6);
    height: calc(var(--gdm-marquee-size) * 0.6);
  }

  .gdm.gdm-marquee--crossed {
    padding-block: max(var(--gdm-pt), 56px) max(var(--gdm-pb), 56px);
  }

  .gdm.gdm-marquee--crossed .gdm-marquee__band {
    width: 110%;
    margin-left: -5%;
    transform: rotate(-2.5deg);
    box-shadow: 0 20px 40px -24px rgba(0, 0, 0, 0.9);
  }

  .gdm.gdm-marquee--crossed .gdm-marquee__band--back {
    z-index: 0;
    transform: rotate(2.5deg);
    border-color: transparent;
    background: var(--gdm-accent);
    color: var(--gdm-on-accent);
  }

  .gdm.gdm-marquee--crossed .gdm-marquee__band--back .gdm-marquee__track {
    animation-direction: reverse;
  }

  .gdm.gdm-marquee--crossed .gdm-marquee__band--back .gdm-marquee__sep {
    color: var(--gdm-on-accent);
  }

  .gdm.gdm-marquee--crossed .gdm-marquee__band--back .gdm-marquee__text.is-outline {
    -webkit-text-stroke-color: var(--gdm-on-accent);
  }

  .gdm.gdm-marquee--crossed .gdm-marquee__band--accent {
    background: var(--gdm-bg);
    color: var(--gdm-text);
    border-color: var(--gdm-border);
  }

  .gdm.gdm-marquee--crossed .gdm-marquee__band--accent .gdm-marquee__sep {
    color: var(--gdm-accent);
  }

  @keyframes gdm-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gdm.gdm-marquee .gdm-marquee__track {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GDM · Bandeau défilant",
  "tag": "section",
  "class": "gdm-shopify-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Mise en page",
      "default": "straight",
      "options": [
        { "value": "straight", "label": "Bandeau droit" },
        { "value": "crossed", "label": "Bandeaux croisés" }
      ]
    },
    {
      "type": "select",
      "id": "band_style",
      "label": "Style du bandeau",
      "default": "dark",
      "options": [
        { "value": "dark", "label": "Sombre" },
        { "value": "surface", "label": "Charbon" },
        { "value": "accent", "label": "Orange" }
      ]
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style du texte",
      "default": "mixed",
      "options": [
        { "value": "filled", "label": "Plein" },
        { "value": "outline", "label": "Contour" },
        { "value": "mixed", "label": "Alterné plein / contour" }
      ]
    },
    {
      "type": "select",
      "id": "size",
      "label": "Taille du texte",
      "default": "medium",
      "options": [
        { "value": "small", "label": "Petite" },
        { "value": "medium", "label": "Moyenne" },
        { "value": "large", "label": "Géante" }
      ]
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Séparateur",
      "default": "hop",
      "options": [
        { "value": "hop", "label": "Houblon" },
        { "value": "wheat", "label": "Épi" },
        { "value": "star", "label": "Étoile" },
        { "value": "sparkle", "label": "Éclat" },
        { "value": "beer", "label": "Chope" },
        { "value": "dot", "label": "Point" }
      ]
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Durée d'un tour",
      "info": "Plus le chiffre est grand, plus le défilement est lent.",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Sens",
      "default": "left",
      "options": [
        { "value": "left", "label": "Vers la gauche" },
        { "value": "right", "label": "Vers la droite" }
      ]
    },
    {
      "type": "header",
      "content": "Couleurs et espacement"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond",
      "default": "#0D0D0D"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#F0921E"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Texte",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Bière artisanale"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (facultatif)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GDM · Bandeau défilant",
      "blocks": [
        { "type": "item", "settings": { "text": "Brassé à Bruguières" } },
        { "type": "item", "settings": { "text": "Bière artisanale" } },
        { "type": "item", "settings": { "text": "IPA · NEIPA · Sour" } },
        { "type": "item", "settings": { "text": "Brewpub & afterwork" } },
        { "type": "item", "settings": { "text": "Depuis 2016" } }
      ]
    }
  ]
}
{% endschema %}
