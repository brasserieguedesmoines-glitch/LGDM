{%- comment -%}
  Le Gué des Moines — Avis clients
  « Ils parlent du Gué des Moines » : note globale en grand (demi-étoiles
  possibles), logo facultatif à côté du badge, bandeau de chiffres clés en
  pilules, carrousel de témoignages (bière notée et note chiffrée facultatives)
  et bandeau d'appel à l'action facultatif. Sert aussi pour les avis Untappd.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading_tag = s.heading_tag | default: 'h2'
  assign reviews = section.blocks | where: 'type', 'review'
  assign stats = section.blocks | where: 'type', 'stat'
-%}
{%- render 'gdm-assets' -%}

<gdm-section
  id="gdm-{{ section.id }}"
  class="gdm gdm-avis gdm-grain"
  style="--gdm-bg: {{ s.color_bg }}; --gdm-accent: {{ s.color_accent }}; --gdm-cols: {{ s.columns }}; --gdm-pt: {{ s.padding_top }}px; --gdm-pb: {{ s.padding_bottom }}px;"
>
  <div class="gdm-glow gdm-avis__glow" aria-hidden="true"></div>
  <div class="gdm-container">
    <gdm-carousel>
      <div class="gdm-avis__top">
        <div class="gdm-head gdm-avis__head">
          {%- if s.logo != blank -%}
            <div class="gdm-avis__brand" data-gdm-reveal>
              <span class="gdm-avis__logo">
                {{- s.logo | image_url: width: 160 | image_tag: loading: 'lazy', width: 48, height: 48 -}}
              </span>
              {%- if s.pill != blank -%}
                <p class="gdm-pill">{{ s.pill | escape }}</p>
              {%- endif -%}
            </div>
          {%- elsif s.pill != blank -%}
            <p class="gdm-pill" data-gdm-reveal>{{ s.pill | escape }}</p>
          {%- endif -%}
          {%- if s.title != blank or s.title_accent != blank -%}
            <{{ heading_tag }} class="gdm-title" data-gdm-reveal style="--gdm-i: 1;">
              {{- s.title | escape }}{% if s.title_accent != blank %} <em>{{ s.title_accent | escape }}</em>{% endif -%}
            </{{ heading_tag }}>
          {%- endif -%}
        </div>

        {%- if s.rating_value != blank -%}
          <div class="gdm-avis__score" data-gdm-reveal style="--gdm-i: 2;">
            <div class="gdm-rating">
              <span class="gdm-rating__value">{{ s.rating_value | escape }}</span>
              <span class="gdm-rating__meta">
                {%- assign rating_label_sr = s.rating_value | append: ' / 5' -%}
                {%- render 'gdm-stars', rating: s.rating_stars, star_size: 18, label: rating_label_sr -%}
                <span class="gdm-rating__label">{{ s.rating_label | escape }}</span>
              </span>
            </div>
            {%- if s.rating_link_label != blank and s.rating_link != blank -%}
              <a class="gdm-link" href="{{ s.rating_link }}" target="_blank" rel="noopener">
                {{- s.rating_link_label | escape -}}
                <span class="gdm-visually-hidden"> (nouvel onglet)</span>
                {%- render 'gdm-icon', name: 'arrow-up-right' -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if stats.size > 0 -%}
        <div class="gdm-stats gdm-avis__stats" data-gdm-reveal style="--gdm-i: 3;">
          {%- for block in stats -%}
            <div class="gdm-stat{% if block.settings.highlight %} gdm-stat--accent{% endif %}" {{ block.shopify_attributes }}>
              <span class="gdm-stat__value">{{ block.settings.value | escape }}</span>
              <span class="gdm-stat__label">{{ block.settings.label | escape }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if reviews.size > 0 -%}
        <div class="gdm-carousel__track gdm-avis__track" data-track tabindex="0" role="region" aria-label="{{ s.label_region | escape }}">
          {%- for block in reviews -%}
            {%- assign b = block.settings -%}
            <figure class="gdm-review gdm-card" data-gdm-reveal style="--gdm-i: {{ forloop.index0 | modulo: 3 }};" {{ block.shopify_attributes }}>
              <div class="gdm-review__top">
                {%- render 'gdm-stars', rating: b.rating, label: b.score -%}
                {%- if b.score != blank -%}
                  {%- assign score_parts = b.score | split: '/' -%}
                  {%- assign score_main = score_parts.first | strip -%}
                  {%- assign score_rest = b.score | remove_first: score_parts.first | strip -%}
                  <span class="gdm-review__score">
                    {{- score_main | escape -}}
                    {%- if score_rest != blank -%}<span class="gdm-review__score-max">{{ score_rest | remove: ' ' | escape }}</span>{%- endif -%}
                  </span>
                {%- else -%}
                  <span class="gdm-review__quote">{% render 'gdm-icon', name: 'quote', icon_size: 34 %}</span>
                {%- endif -%}
              </div>
              {%- if b.title != blank -%}
                <p class="gdm-review__title">{{ b.title | escape }}</p>
              {%- endif -%}
              <div class="gdm-review__text">{{ b.text }}</div>
              <figcaption class="gdm-review__author">
                <span class="gdm-review__avatar" aria-hidden="true">
                  {%- if b.avatar != blank -%}
                    {{ b.avatar | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', width: 48, height: 48 }}
                  {%- else -%}
                    {{ b.author | strip | slice: 0 | upcase }}
                  {%- endif -%}
                </span>
                <span class="gdm-review__who">
                  <span class="gdm-review__name">{{ b.author | escape }}</span>
                  {%- if b.subject != blank -%}<span class="gdm-review__subject">{{ b.subject | escape }}</span>{%- endif -%}
                  {%- if b.meta != blank -%}<span class="gdm-review__meta">{{ b.meta | escape }}</span>{%- endif -%}
                </span>
                {%- if b.source != 'none' -%}
                  <span class="gdm-review__source">{{ b.source }}</span>
                {%- endif -%}
              </figcaption>
            </figure>
          {%- endfor -%}
        </div>

        <div class="gdm-avis__foot" data-carousel-ui>
          <div class="gdm-carousel__progress" data-progress aria-hidden="true"><span></span></div>
          <div class="gdm-carousel__nav">
            <button type="button" class="gdm-icon-btn" data-prev aria-label="{{ s.label_prev | escape }}">{% render 'gdm-icon', name: 'chevron-left' %}</button>
            <button type="button" class="gdm-icon-btn" data-next aria-label="{{ s.label_next | escape }}">{% render 'gdm-icon', name: 'chevron-right' %}</button>
          </div>
        </div>
      {%- endif -%}
    </gdm-carousel>

    {%- if s.cta_title != blank -%}
      <div class="gdm-avis__cta" data-gdm-reveal>
        <div class="gdm-avis__cta-copy">
          <p class="gdm-avis__cta-title">{{ s.cta_title | escape }}</p>
          {%- if s.cta_text != blank -%}
            <p class="gdm-avis__cta-text">{{ s.cta_text }}</p>
          {%- endif -%}
        </div>
        {%- if s.cta_button_label != blank or s.cta_button2_label != blank -%}
          <div class="gdm-actions gdm-avis__cta-actions">
            {%- if s.cta_button_label != blank -%}
              {%- assign cta_link = s.cta_button_link | default: '#' -%}
              <a class="gdm-btn gdm-btn--primary" href="{{ cta_link }}"{% if cta_link contains '://' %} target="_blank" rel="noopener"{% endif %}>
                {{- s.cta_button_label | escape -}}
                {%- if cta_link contains '://' %}<span class="gdm-visually-hidden"> (nouvel onglet)</span>{% endif -%}
                {%- render 'gdm-icon', name: 'arrow-up-right' -%}
              </a>
            {%- endif -%}
            {%- if s.cta_button2_label != blank -%}
              {%- assign cta_link = s.cta_button2_link | default: '#' -%}
              <a class="gdm-btn gdm-btn--ghost" href="{{ cta_link }}"{% if cta_link contains '://' %} target="_blank" rel="noopener"{% endif %}>
                {{- s.cta_button2_label | escape -}}
                {%- if cta_link contains '://' %}<span class="gdm-visually-hidden"> (nouvel onglet)</span>{% endif -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</gdm-section>

{% stylesheet %}
  .gdm.gdm-avis .gdm-avis__glow {
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.7;
  }

  .gdm.gdm-avis .gdm-avis__top {
    display: grid;
    gap: 28px;
    align-items: end;
    margin-bottom: 28px;
  }

  @media (min-width: 990px) {
    .gdm.gdm-avis .gdm-avis__top {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
    }
  }

  .gdm.gdm-avis .gdm-avis__head {
    margin-bottom: 0;
  }

  .gdm.gdm-avis .gdm-avis__brand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .gdm.gdm-avis .gdm-avis__logo {
    display: block;
    flex: none;
    width: 48px;
    height: 48px;
    overflow: hidden;
    border: 1px solid var(--gdm-line);
    border-radius: 14px;
    background: var(--gdm-surface);
  }

  .gdm.gdm-avis .gdm-avis__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gdm.gdm-avis .gdm-avis__score {
    display: grid;
    justify-items: start;
    gap: 14px;
    padding: 22px 26px;
    border: 1px solid var(--gdm-line);
    border-radius: var(--gdm-radius);
    background: var(--gdm-surface);
  }

  .gdm.gdm-avis .gdm-avis__score .gdm-rating__value {
    font-size: 76px;
  }

  .gdm.gdm-avis .gdm-avis__stats {
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  .gdm.gdm-avis .gdm-avis__track {
    --gdm-slide: 86%;
    align-items: stretch;
  }

  @media (min-width: 750px) {
    .gdm.gdm-avis .gdm-avis__track {
      --gdm-slide: calc((100% - var(--gdm-gap)) / 2.1);
    }
  }

  @media (min-width: 990px) {
    .gdm.gdm-avis .gdm-avis__track {
      --gdm-slide: calc((100% - (var(--gdm-cols, 3) - 1) * var(--gdm-gap)) / var(--gdm-cols, 3));
    }
  }

  .gdm.gdm-avis .gdm-review {
    display: flex;
    flex-direction: column;
    gap: 18px;
    height: 100%;
    margin: 0;
    padding: 28px;
  }

  .gdm.gdm-avis .gdm-review:hover {
    background: var(--gdm-surface-2);
  }

  .gdm.gdm-avis .gdm-review__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .gdm.gdm-avis .gdm-review__quote {
    color: var(--gdm-line);
    transition: color 0.3s var(--gdm-ease);
  }

  .gdm.gdm-avis .gdm-review:hover .gdm-review__quote {
    color: var(--gdm-accent);
  }

  .gdm.gdm-avis .gdm-review__score {
    display: inline-flex;
    align-items: baseline;
    flex: none;
    gap: 3px;
    margin-top: -6px;
    color: var(--gdm-accent);
    font-family: var(--gdm-font-display);
    font-size: 36px;
    line-height: 1;
    white-space: nowrap;
  }

  .gdm.gdm-avis .gdm-review__score-max {
    color: var(--gdm-muted);
    font-family: var(--gdm-font-body);
    font-size: 14px;
    font-weight: 500;
  }

  .gdm.gdm-avis .gdm-review__title {
    font-family: var(--gdm-font-display);
    font-size: 24px;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--gdm-text);
  }

  .gdm.gdm-avis .gdm-review__text {
    flex: 1;
    margin: 0;
    padding: 0;
    border: 0;
    color: #d6d1c8;
    font-size: 16px;
    font-style: normal;
    line-height: 1.65;
  }

  .gdm.gdm-avis .gdm-review__text p + p {
    margin-top: 0.8em;
  }

  .gdm.gdm-avis .gdm-review__author {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--gdm-border);
  }

  .gdm.gdm-avis .gdm-review__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    overflow: hidden;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--gdm-accent), var(--gdm-line));
    color: var(--gdm-on-accent);
    font-family: var(--gdm-font-display);
    font-size: 22px;
    line-height: 1;
  }

  .gdm.gdm-avis .gdm-review__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gdm.gdm-avis .gdm-review__who {
    display: grid;
    flex: 1 1 144px;
    min-width: 0;
    gap: 2px;
  }

  .gdm.gdm-avis .gdm-review__name {
    color: var(--gdm-text);
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  .gdm.gdm-avis .gdm-review__subject {
    color: var(--gdm-accent);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .gdm.gdm-avis .gdm-review__meta {
    color: var(--gdm-muted);
    font-size: 13px;
    line-height: 1.3;
  }

  .gdm.gdm-avis .gdm-review__source {
    flex: none;
    padding: 5px 10px;
    border: 1px solid var(--gdm-border);
    border-radius: 999px;
    color: var(--gdm-muted);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gdm.gdm-avis .gdm-avis__foot {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
  }

  .gdm.gdm-avis .gdm-avis__foot .gdm-carousel__progress {
    flex: 1;
    margin-top: 0;
  }

  .gdm.gdm-avis .gdm-avis__cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 22px;
    margin-top: clamp(32px, 4vw, 48px);
    padding: 26px 24px;
    border: 1px solid var(--gdm-border);
    border-radius: var(--gdm-radius);
    background: radial-gradient(120% 160% at 0% 50%, var(--gdm-accent-soft), transparent 62%), var(--gdm-surface);
  }

  @media (min-width: 990px) {
    .gdm.gdm-avis .gdm-avis__cta {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 40px;
      padding: 30px 36px;
    }
  }

  .gdm.gdm-avis .gdm-avis__cta-copy {
    display: grid;
    gap: 8px;
  }

  .gdm.gdm-avis .gdm-avis__cta-title {
    color: var(--gdm-text);
    font-family: var(--gdm-font-display);
    font-size: clamp(24px, 18px + 1.2vw, 34px);
    line-height: 1.08;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .gdm.gdm-avis .gdm-avis__cta-text {
    max-width: 62ch;
    color: var(--gdm-muted);
    font-size: 15px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .gdm.gdm-avis .gdm-avis__cta-text strong {
    color: var(--gdm-text);
    font-weight: 600;
  }

  .gdm.gdm-avis .gdm-avis__cta-text a {
    color: var(--gdm-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 749px) {
    .gdm.gdm-avis .gdm-avis__top {
      gap: 16px;
      margin-bottom: 20px;
    }

    .gdm.gdm-avis .gdm-avis__score {
      gap: 4px;
      padding: 14px 18px;
    }

    .gdm.gdm-avis .gdm-avis__score .gdm-rating__value {
      font-size: 52px;
    }

    .gdm.gdm-avis .gdm-review {
      gap: 14px;
      padding: 20px;
    }

    .gdm.gdm-avis .gdm-review__author {
      padding-top: 14px;
    }

    .gdm.gdm-avis .gdm-avis__foot {
      margin-top: 16px;
    }

    .gdm.gdm-avis .gdm-avis__stats .gdm-stat {
      align-content: start;
    }

    .gdm.gdm-avis .gdm-avis__cta-actions,
    .gdm.gdm-avis .gdm-avis__cta-actions .gdm-btn {
      width: 100%;
    }

    .gdm.gdm-avis .gdm-avis__cta-actions .gdm-btn {
      padding-inline: 20px;
      white-space: normal;
      letter-spacing: 0.06em;
      text-align: center;
    }
  }

  /* Ordinateur : note et cartes plus compactes. */
  @media (min-width: 990px) {
    .gdm.gdm-avis .gdm-avis__top {
      margin-bottom: 24px;
    }

    .gdm.gdm-avis .gdm-avis__score {
      gap: 8px;
      padding: 16px 22px;
    }

    .gdm.gdm-avis .gdm-avis__score .gdm-rating__value {
      font-size: 56px;
    }

    .gdm.gdm-avis .gdm-review {
      gap: 12px;
      padding: 22px;
    }

    .gdm.gdm-avis .gdm-review__author {
      padding-top: 12px;
    }

    .gdm.gdm-avis .gdm-avis__foot {
      margin-top: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GDM · Avis clients",
  "tag": "section",
  "class": "gdm-shopify-section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "header",
      "content": "En-tête"
    },
    {
      "type": "text",
      "id": "pill",
      "label": "Badge",
      "default": "Avis clients vérifiés"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo à côté du badge (facultatif)",
      "info": "Par exemple le logo Untappd ou celui de la brasserie. Image carrée conseillée."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Ils parlent du"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Titre — partie orange",
      "default": "Gué des Moines"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Niveau du titre (SEO)",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ]
    },
    {
      "type": "header",
      "content": "Note globale"
    },
    {
      "type": "text",
      "id": "rating_value",
      "label": "Note",
      "default": "5,0",
      "info": "Laisser vide pour masquer l'encart de note."
    },
    {
      "type": "range",
      "id": "rating_stars",
      "label": "Étoiles",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "default": 5,
      "info": "Par demi-étoile : 3,5 affiche trois étoiles et demie."
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Légende",
      "default": "Note moyenne sur Google"
    },
    {
      "type": "text",
      "id": "rating_link_label",
      "label": "Texte du lien",
      "default": "Voir tous les avis"
    },
    {
      "type": "url",
      "id": "rating_link",
      "label": "Lien vers vos avis",
      "info": "Par exemple votre fiche Google."
    },
    {
      "type": "header",
      "content": "Carrousel"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Avis visibles sur ordinateur",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "label_region",
      "label": "Nom du carrousel (accessibilité)",
      "default": "Avis de nos clients"
    },
    {
      "type": "text",
      "id": "label_prev",
      "label": "Flèche précédente (accessibilité)",
      "default": "Avis précédents"
    },
    {
      "type": "text",
      "id": "label_next",
      "label": "Flèche suivante (accessibilité)",
      "default": "Avis suivants"
    },
    {
      "type": "header",
      "content": "Bandeau d'appel à l'action"
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "Titre du bandeau",
      "info": "Laisser vide pour masquer le bandeau en bas de section."
    },
    {
      "type": "inline_richtext",
      "id": "cta_text",
      "label": "Texte du bandeau"
    },
    {
      "type": "text",
      "id": "cta_button_label",
      "label": "Bouton principal — texte"
    },
    {
      "type": "url",
      "id": "cta_button_link",
      "label": "Bouton principal — lien",
      "info": "Un lien externe (https://…) s'ouvre dans un nouvel onglet."
    },
    {
      "type": "text",
      "id": "cta_button2_label",
      "label": "Bouton secondaire — texte"
    },
    {
      "type": "url",
      "id": "cta_button2_link",
      "label": "Bouton secondaire — lien"
    },
    {
      "type": "header",
      "content": "Couleurs et espacement"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond",
      "default": "#0D0D0D"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#F0921E"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 4,
