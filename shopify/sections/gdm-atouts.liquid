{%- comment -%}
  Le Gué des Moines — Atouts : bandeau de réassurance compact (paiement sécurisé,
  click & collect, fabrication artisanale, service client…), avec icône dans un
  cercle ambré ou image personnalisée, titre et texte court (liens possibles).
  Colonnes sur ordinateur : une seule rangée jusqu'à 4 atouts ; au-delà,
  3 colonnes pour 5-6 atouts, 4 colonnes pour 7-8. Sur mobile et tablette : 2 × 2.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading_tag = s.heading_tag | default: 'h2'
  assign count = section.blocks.size

  assign cols = count | at_least: 1
  if count > 4
    assign cols = 4
    if count < 7
      assign cols = 3
    endif
  endif

  assign classes = 'gdm gdm-atouts gdm-atouts--' | append: s.layout | append: ' gdm-atouts--align-' | append: s.alignment | append: ' gdm-atouts--cols-' | append: cols
  if count == 1
    assign classes = classes | append: ' gdm-atouts--single'
  endif
-%}
{%- render 'gdm-assets' -%}

<gdm-section
  id="gdm-{{ section.id }}"
  class="{{ classes }}"
  style="--gdm-bg: {{ s.color_bg }}; --gdm-accent: {{ s.color_accent }}; --gdm-pt: {{ s.padding_top }}px; --gdm-pb: {{ s.padding_bottom }}px; --gdm-cols: {{ cols }};"
>
  <div class="gdm-container">
    {%- if s.pill != blank or s.title != blank or s.title_accent != blank or s.text != blank -%}
      <div class="gdm-head gdm-head--center gdm-atouts__head">
        {%- if s.pill != blank -%}
          <p class="gdm-pill" data-gdm-reveal>{{ s.pill | escape }}</p>
        {%- endif -%}
        {%- if s.title != blank or s.title_accent != blank -%}
          <{{ heading_tag }} class="gdm-title gdm-atouts__title" data-gdm-reveal style="--gdm-i: 1;">
            {{- s.title | escape }}{% if s.title_accent != blank %} <em>{{ s.title_accent | escape }}</em>{% endif -%}
          </{{ heading_tag }}>
        {%- endif -%}
        {%- if s.text != blank -%}
          <p class="gdm-lead gdm-atouts__lead" data-gdm-reveal style="--gdm-i: 2;">{{ s.text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if count > 0 -%}
      <ul
        class="gdm-atouts__list"
        {% if s.layout == 'divided' %}data-gdm-reveal style="--gdm-i: 3;"{% endif %}
        {% if s.list_label != blank %}aria-label="{{ s.list_label | escape }}"{% endif %}
      >
        {%- for block in section.blocks -%}
          {%- comment -%}
            Permet aux adresses e-mail de passer à la ligne juste après « @ »
            (cases étroites sur mobile), sans toucher aux attributs des liens.
          {%- endcomment -%}
          {%- liquid
            assign b = block.settings
            assign text_html = b.text
            if text_html contains '@'
              assign chunks = text_html | split: '<'
              assign text_html = ''
              for chunk in chunks
                if forloop.first
                  assign text_html = chunk | replace: '@', '@<wbr>'
                else
                  assign tag_part = chunk | split: '>' | first
                  assign text_part = chunk | remove_first: tag_part | remove_first: '>' | replace: '@', '@<wbr>'
                  assign text_html = text_html | append: '<' | append: tag_part | append: '>' | append: text_part
                endif
              endfor
            endif
          -%}
          <li
            class="gdm-atouts__item{% if s.layout == 'cards' %} gdm-card{% endif %}"
            {% if s.layout == 'cards' %}data-gdm-reveal style="--gdm-i: {{ forloop.index0 | modulo: 4 }};"{% endif %}
            {{ block.shopify_attributes }}
          >
            <span class="gdm-atouts__media{% if b.image != blank %} gdm-atouts__media--image{% endif %}" aria-hidden="true">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 120, 160', sizes: '64px', class: 'gdm-atouts__img', alt: '' }}
              {%- else -%}
                {%- render 'gdm-icon', name: b.icon, icon_size: 24 -%}
              {%- endif -%}
            </span>
            <span class="gdm-atouts__body">
              {%- if b.title != blank -%}
                <span class="gdm-atouts__name">{{ b.title | escape }}</span>
              {%- endif -%}
              {%- if b.text != blank -%}
                <span class="gdm-atouts__text">{{ text_html }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</gdm-section>

{% stylesheet %}
  /* ---------- En-tête (facultatif) : plus resserré que dans les autres sections ---------- */
  .gdm.gdm-atouts .gdm-atouts__head {
    gap: 16px;
    margin-bottom: clamp(28px, 4vw, 40px);
  }

  .gdm.gdm-atouts .gdm-atouts__title {
    font-size: clamp(32px, 22px + 2.4vw, 52px);
  }

  .gdm.gdm-atouts .gdm-atouts__lead a {
    color: var(--gdm-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .gdm.gdm-atouts .gdm-atouts__lead a:hover {
    color: var(--gdm-text);
  }

  /* ---------- Grille : 2 × 2 sur mobile et tablette, une rangée sur ordinateur ---------- */
  .gdm.gdm-atouts .gdm-atouts__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .gdm.gdm-atouts--single .gdm-atouts__list {
    grid-template-columns: minmax(0, 1fr);
  }

  /* Nombre impair d'atouts : le dernier occupe toute la largeur. */
  .gdm.gdm-atouts .gdm-atouts__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  @media (min-width: 750px) {
    .gdm.gdm-atouts .gdm-atouts__list {
      gap: 16px;
    }
  }

  @media (min-width: 990px) {
    .gdm.gdm-atouts .gdm-atouts__list {
      grid-template-columns: repeat(var(--gdm-cols, 4), minmax(0, 1fr));
      gap: 20px;
    }

    .gdm.gdm-atouts .gdm-atouts__item:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }

  /* ---------- Atout ---------- */
  .gdm.gdm-atouts .gdm-atouts__item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    min-width: 0;
    padding: 24px 18px;
    text-align: center;
  }

  .gdm.gdm-atouts--cards .gdm-atouts__item {
    border-radius: 22px;
  }

  .gdm.gdm-atouts--cards .gdm-atouts__item:hover {
    background: var(--gdm-surface-2);
  }

  /* Cercle ambré */
  .gdm.gdm-atouts .gdm-atouts__media {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 56px;
    height: 56px;
    border: 1px solid var(--gdm-line);
    border-radius: 50%;
    background: var(--gdm-accent-soft);
    color: var(--gdm-accent);
    box-shadow: inset 0 0 18px var(--gdm-accent-glow);
    transition: transform 0.35s var(--gdm-ease), border-color 0.35s var(--gdm-ease), box-shadow 0.35s var(--gdm-ease);
  }

  .gdm.gdm-atouts .gdm-atouts__media svg {
    width: 24px;
    height: 24px;
  }

  /* Pictogramme illustré de la marque : affiché en entier, sans cercle. */
  .gdm.gdm-atouts .gdm-atouts__media--image {
    width: 64px;
    height: 64px;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
  }

  .gdm.gdm-atouts .gdm-atouts__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gdm.gdm-atouts .gdm-atouts__item:hover .gdm-atouts__media {
    border-color: var(--gdm-accent);
    box-shadow: inset 0 0 18px var(--gdm-accent-glow), 0 0 0 5px var(--gdm-accent-soft);
    transform: translateY(-2px);
  }

  .gdm.gdm-atouts .gdm-atouts__item:hover .gdm-atouts__media--image {
    box-shadow: none;
  }

  .gdm.gdm-atouts .gdm-atouts__body {
    display: grid;
    gap: 6px;
    min-width: 0;
    max-width: 100%;
  }

  .gdm.gdm-atouts .gdm-atouts__name {
    color: var(--gdm-text);
    font-family: var(--gdm-font-display);
    font-size: clamp(17px, 15px + 0.35vw, 21px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0.03em;
    text-transform: none;
    text-wrap: balance;
  }

  .gdm.gdm-atouts .gdm-atouts__text {
    color: var(--gdm-muted);
    font-size: 14px;
    line-height: 1.5;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .gdm.gdm-atouts .gdm-atouts__text strong {
    color: var(--gdm-text);
    font-weight: 600;
  }

  /* Liens du texte (ex. adresse e-mail) : couleur fixée, zone tactile agrandie sans décaler le texte. */
  .gdm.gdm-atouts .gdm-atouts__text a {
    display: inline-block;
    max-width: 100%;
    padding-block: 12px;
    margin-block: -12px;
    color: var(--gdm-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.2s var(--gdm-ease);
  }

  .gdm.gdm-atouts .gdm-atouts__text a:hover {
    color: var(--gdm-text);
    text-decoration-thickness: 2px;
  }

  /* ---------- Variante « Bandeau » : un seul panneau, séparateurs fins ---------- */
  .gdm.gdm-atouts--divided .gdm-atouts__list {
    gap: 0;
    border: 1px solid var(--gdm-border);
    border-radius: 24px;
    background: linear-gradient(180deg, var(--gdm-surface-2), var(--gdm-surface));
    overflow: hidden;
  }

  /* Chaque case trace un trait à gauche et au-dessus d'elle ; ceux du bord sont rognés par le panneau. */
  .gdm.gdm-atouts--divided .gdm-atouts__item::before,
  .gdm.gdm-atouts--divided .gdm-atouts__item::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .gdm.gdm-atouts--divided .gdm-atouts__item::before {
    top: 14%;
    bottom: 14%;
    left: -1px;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--gdm-border-strong) 30%, var(--gdm-border-strong) 70%, transparent);
  }

  .gdm.gdm-atouts--divided .gdm-atouts__item::after {
    top: -1px;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gdm-border-strong) 30%, var(--gdm-border-strong) 70%, transparent);
  }

  @media (min-width: 990px) {
    .gdm.gdm-atouts--divided .gdm-atouts__list {
      gap: 0;
    }

    .gdm.gdm-atouts--divided .gdm-atouts__item {
      padding: 30px 24px;
    }
  }

  /* ---------- Alignement à gauche : icône à côté du texte dès la tablette ---------- */
  .gdm.gdm-atouts--align-left .gdm-atouts__item {
    align-items: flex-start;
    text-align: left;
  }

  @media (min-width: 750px) {
    .gdm.gdm-atouts--align-left .gdm-atouts__item {
      flex-direction: row;
      align-items: center;
      gap: 16px;
    }
  }

  @media (min-width: 990px) {
    .gdm.gdm-atouts--align-left .gdm-atouts__item {
      padding-inline: 20px;
    }
  }

  /* Petits ordinateurs : 4 cases trop étroites pour l'icône à côté du texte, elle repasse au-dessus. */
  @media (min-width: 990px) and (max-width: 1199px) {
    .gdm.gdm-atouts--align-left.gdm-atouts--cols-4 .gdm-atouts__item {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 749px) {
    .gdm.gdm-atouts .gdm-atouts__head {
      margin-bottom: 24px;
    }

    .gdm.gdm-atouts .gdm-atouts__list {
      gap: 10px;
    }

    .gdm.gdm-atouts--divided .gdm-atouts__list {
      gap: 0;
      border-radius: 22px;
    }

    .gdm.gdm-atouts .gdm-atouts__item {
      gap: 6px;
      padding: 12px 8px;
    }

    .gdm.gdm-atouts--cards .gdm-atouts__item {
      border-radius: 18px;
    }

    .gdm.gdm-atouts .gdm-atouts__media {
      width: 40px;
      height: 40px;
    }

    .gdm.gdm-atouts .gdm-atouts__media svg {
      width: 22px;
      height: 22px;
    }

    .gdm.gdm-atouts .gdm-atouts__body {
      gap: 4px;
    }

    .gdm.gdm-atouts .gdm-atouts__name {
      letter-spacing: 0.02em;
    }

    .gdm.gdm-atouts .gdm-atouts__text {
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gdm.gdm-atouts .gdm-atouts__media {
      transition: none;
    }

    .gdm.gdm-atouts .gdm-atouts__item:hover .gdm-atouts__media {
      transform: none;
    }
  }

  /* Ordinateur : bandeau d'atouts plus bas. */
  @media (min-width: 990px) {
    .gdm.gdm-atouts--divided .gdm-atouts__item {
      padding: 16px 20px;
    }

    .gdm.gdm-atouts .gdm-atouts__media--image {
      width: 48px;
      height: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GDM · Atouts",
  "tag": "section",
  "class": "gdm-shopify-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "En-tête (facultatif)"
    },
    {
      "type": "paragraph",
      "content": "Laissez ces champs vides pour un simple bandeau de réassurance."
    },
    {
      "type": "text",
      "id": "pill",
      "label": "Badge"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Titre — partie orange"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Niveau du titre (SEO)",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Style",
      "default": "divided",
      "options": [
        { "value": "divided", "label": "Bandeau à séparateurs fins" },
        { "value": "cards", "label": "Cartes compactes" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Disposition des atouts",
      "default": "center",
      "options": [
        { "value": "center", "label": "Centrée, icône au-dessus" },
        { "value": "left", "label": "À gauche, icône à côté du texte" }
      ],
      "info": "Sur mobile, l'icône reste au-dessus du texte."
    },
    {
      "type": "text",
      "id": "list_label",
      "label": "Intitulé de la liste (accessibilité)",
      "default": "Nos engagements"
    },
    {
      "type": "header",
      "content": "Couleurs et espacement"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fond",
      "default": "#0D0D0D"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Accent",
      "default": "#F0921E"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "atout",
      "name": "Atout",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "default": "lock",
          "options": [
            { "value": "lock", "label": "Cadenas" },
            { "value": "shield", "label": "Bouclier" },
            { "value": "store", "label": "Boutique" },
            { "value": "award", "label": "Médaille" },
            { "value": "map-pin", "label": "Lieu" },
            { "value": "mail", "label": "E-mail" },
            { "value": "truck", "label": "Livraison" },
            { "value": "beer", "label": "Chope" },
            { "value": "hop", "label": "Houblon" },
            { "value": "gift", "label": "Cadeau" },
            { "value": "percent", "label": "Pourcentage" },
            { "value": "clock", "label": "Horloge" },
            { "value": "phone", "label": "Téléphone" },
            { "value": "heart", "label": "Cœur" },
            { "value": "star", "label": "Étoile" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image personnalisée (facultatif)",
          "info": "Remplace l'icône. Pictogramme carré sur fond transparent, 160 × 160 px minimum."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Paiement sécurisé"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Texte",
          "default": "Transactions chiffrées",
          "info": "Vous pouvez y insérer un lien, par exemple vers une adresse e-mail (mailto:)."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GDM · Atouts",
      "blocks": [
        { "type": "atout", "settings": { "icon": "lock", "title": "Paiement sécurisé", "text": "Transactions chiffrées" } },
        { "type": "atout", "settings": { "icon": "store", "title": "Click & collect", "text": "Retrait à la brasserie" } },
        { "type": "atout", "settings": { "icon": "award", "title": "Bière artisanale", "text": "Brassée sur place" } },
        { "type": "atout", "settings": { "icon": "mail", "title": "Service client", "text": "Réponse rapide par e-mail" } }
      ]
    }
  ]
}
{% endschema %}
