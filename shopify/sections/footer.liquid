<style>
  :root {
    --acc: #FF9900;
    --acc-g: rgba(255,153,0,0.10);
    --acc-b: rgba(255,153,0,0.28);
    --c: #161616;
    --ln: rgba(255,255,255,0.08);
    --tx: #f2f0ec;
    --mu: rgba(242,240,236,0.60);
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .shopify-section:has(.gdm-footer) { padding: 0 !important; margin: 0 !important; }

  .gdm-footer {
    background: #0d0d0d;
    color: var(--tx);
    font-family: 'DM Sans', sans-serif;
    width: 100%;
  }

  /* ── Body grid ── */
  .gdm-footer__body {
    padding: 40px 48px 32px;
    display: grid;
    grid-template-columns: 220px 1fr 1fr 1fr;
    gap: 28px 48px;
  }

  /* ── Brand card ── */
  .gdm-footer__brand-card {
    background: var(--c);
    border: 1px solid var(--ln);
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
  }
  .gdm-footer__logo { display: block; width: 48px; margin-bottom: 14px; }
  .gdm-footer__brand-name {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.01em;
    color: var(--tx);
    margin-bottom: 4px;
    text-transform: uppercase;
  }
  .gdm-footer__tagline { font-size: 12px; color: var(--mu); line-height: 1.55; margin-bottom: 16px; }
  .gdm-footer__sep { height: 1px; background: var(--ln); margin-bottom: 14px; }
  .gdm-footer__ci {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin-bottom: 9px;
    font-size: 12px;
    color: var(--mu);
    text-decoration: none;
    line-height: 1.45;
    transition: color .15s;
  }
  .gdm-footer__ci:hover { color: var(--acc); }
  .gdm-footer__ci svg { flex-shrink: 0; margin-top: 1px; opacity: .45; }
  .gdm-footer__hours {
    margin-top: 4px;
    padding: 10px 12px;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--ln);
    border-radius: 10px;
    font-size: 11px;
    color: var(--mu);
    line-height: 1.7;
  }
  .gdm-footer__hours strong {
    display: block;
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--acc);
    margin-bottom: 5px;
    font-weight: 700;
  }

  /* ── Nav cols ── */
  .gdm-footer__col { position: relative; }
  .gdm-footer__col-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tx);
    margin: 0 0 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ln);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .gdm-footer__summary { display: block; list-style: none; }
  .gdm-footer__summary::-webkit-details-marker { display: none; }
  .gdm-footer__summary .gdm-footer__col-title { margin-bottom: 14px; }
  @media (min-width: 521px) {
    .gdm-footer__summary { pointer-events: none; }
  }
  .gdm-footer__col-title::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--acc);
    flex-shrink: 0;
  }
  .gdm-footer__nav { list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .gdm-footer__nav li { display: block; }
  .gdm-footer__nav a {
    font-size: 12.5px;
    color: var(--mu);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: color .15s;
    line-height: 1.35;
    padding: 4px 0;
    position: relative;
    z-index: 1;
  }
  .gdm-footer__nav a:hover { color: var(--tx); }

  .gdm-footer__geo {
    display: inline-flex;
    align-items: center;
    font-size: 9.5px;
    font-weight: 700;
    color: var(--acc);
    background: var(--acc-g);
    border: 1px solid var(--acc-b);
    border-radius: 4px;
    padding: 1px 5px;
    margin-left: 4px;
    line-height: 1.5;
  }
  .gdm-footer__sub { margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--ln); }
  .gdm-footer__sub .gdm-footer__col-title { font-size: 12px; }

  /* ── Bottom bar ── */
  .gdm-footer__bottom {
    border-top: 1px solid var(--ln);
    padding: 14px 48px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .gdm-footer__legal { margin: 0; font-size: 11px; color: rgba(242,240,236,0.6); }
  .gdm-footer__legal a { color: rgba(242,240,236,0.75); text-decoration: none; transition: color .15s; }
  .gdm-footer__legal a:hover { color: var(--acc); }
  .gdm-footer__socials { display: flex; gap: 6px; }
  .gdm-footer__soc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 7px;
    border: 1px solid var(--ln);
    color: var(--mu);
    text-decoration: none;
    transition: border-color .15s, color .15s, background .15s;
  }
  .gdm-footer__soc:hover { border-color: var(--acc-b); color: var(--acc); background: var(--acc-g); }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .gdm-footer__body { grid-template-columns: 1fr 1fr; padding: 32px 24px 24px; }
    .gdm-footer__brand-card { grid-column: 1 / -1; }
    .gdm-footer__bottom { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 520px) {
    .gdm-footer__body { grid-template-columns: 1fr; gap: 0; padding: 20px 16px 8px; }
    .gdm-footer__bottom { flex-direction: column; align-items: flex-start; padding: 12px 16px; }

    /* Carte de marque compacte : logo à côté du nom, horaires sur 2 colonnes. */
    .gdm-footer__brand-card { display: grid; grid-template-columns: 44px 1fr; column-gap: 12px; margin-bottom: 12px; padding: 14px 16px; }
    .gdm-footer__brand-card > a:first-child { grid-row: 1 / span 2; align-self: center; }
    .gdm-footer__logo { width: 44px; margin: 0; }
    .gdm-footer__brand-name { margin: 0; align-self: end; }
    .gdm-footer__tagline { margin: 0; }
    .gdm-footer__sep, .gdm-footer__ci, .gdm-footer__hours { grid-column: 1 / -1; }
    .gdm-footer__sep { margin: 12px 0 6px; }
    .gdm-footer__ci { min-height: 36px; align-items: center; margin: 0; }
    .gdm-footer__hours { columns: 2; column-gap: 12px; line-height: 1.6; }
    .gdm-footer__hours strong { column-span: all; }

    /* Colonnes de liens en accordéon. */
    .gdm-footer__summary { display: flex; align-items: center; min-height: 48px; border-bottom: 1px solid var(--ln); cursor: pointer; }
    .gdm-footer__summary .gdm-footer__col-title { flex: 1; margin: 0; padding: 0; border: 0; }
    .gdm-footer__summary::after { content: '+'; color: var(--acc); font-size: 20px; line-height: 1; }
    .gdm-footer__col[open] > .gdm-footer__summary::after { content: '–'; }
    .gdm-footer__col[open] > .gdm-footer__nav { padding: 6px 0 10px; }
    .gdm-footer__nav a { min-height: 44px; }
    .gdm-footer__sub { margin-top: 4px; }
    .gdm-footer__soc { width: 44px; height: 44px; }
  }
</style>

