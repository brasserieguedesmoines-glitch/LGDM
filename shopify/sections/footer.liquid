<script>
  /* Pied de page : colonnes repliées sur mobile, toujours ouvertes sur ordinateur. */
  (() => {
    const cols = document.querySelectorAll('.gdm-footer__col');
    const mobile = window.matchMedia('(max-width: 520px)');
    const sync = () => cols.forEach((col) => {
      col.open = !mobile.matches;
      col.querySelector('summary').tabIndex = mobile.matches ? 0 : -1;
    });
    cols.forEach((col) => col.addEventListener('toggle', () => {
      if (!mobile.matches && !col.open) col.open = true;
    }));
    sync();
    mobile.addEventListener('change', sync);
  })();
</script>
