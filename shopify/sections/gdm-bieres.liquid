{%- comment -%}
  Le Gué des Moines — Nos bières
  Cartes produit sombres avec halo ambré : style, degré, IBU (métachamps
  custom.degre / custom.ibu), jauge d'amertume, choix 33 cL / 75 cL
  et ajout au panier direct. En carrousel ou en grille.
  Sur une page collection, sans collection choisie : la collection affichée
  (titre de la collection en guise de titre). Sur une fiche produit : la bière
  affichée n'est pas répétée dans la liste.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign page_product_id = product.id
  assign collection = s.collection | default: collection
  assign title_main = s.title
  assign title_end = s.title_accent
  if s.title == blank and s.title_accent == blank and template.name == 'collection'
    assign title_main = collection.title
  endif
  assign is_carousel = false
  if s.layout == 'carousel'
    assign is_carousel = true
  endif
  assign heading_tag = s.heading_tag | default: 'h2'
-%}
{%- render 'gdm-assets' -%}

{%- capture cards -%}
  {%- if collection != blank and collection.products_count > 0 -%}
    {%- for product in collection.products limit: s.limit -%}
      {%- if product.id == page_product_id -%}{%- continue -%}{%- endif -%}
      {%- render 'gdm-beer-card', product: product, s: s, card_id: section.id, index: forloop.index0 -%}
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..4) -%}
      <article class="gdm-beer gdm-card" data-gdm-reveal style="--gdm-i: {{ forloop.index0 }};">
        <div class="gdm-beer__media">
          <span class="gdm-beer__halo"></span>
          {%- capture ph -%}product-{{ i }}{%- endcapture -%}
          {{ ph | placeholder_svg_tag: 'gdm-placeholder' }}
        </div>
        <div class="gdm-beer__body">
          <p class="gdm-beer__style">IPA</p>
          <h3 class="gdm-beer__title">Nom de la bière</h3>
          <ul class="gdm-beer__specs">
            <li><strong>6,2 %</strong> alc.</li>
            <li><strong>45</strong> IBU</li>
          </ul>
          <div class="gdm-beer__foot">
            <p class="gdm-beer__price"><span>3,80 €</span></p>
          </div>
        </div>
      </article>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<gdm-section
  id="gdm-{{ section.id }}"
  class="gdm gdm-bieres"
  style="--gdm-bg: {{ s.color_bg }}; --gdm-accent: {{ s.color_accent }}; --gdm-cols: {{ s.columns }}; --gdm-pt: {{ s.padding_top }}px; --gdm-pb: {{ s.padding_bottom }}px;"
>
  <div class="gdm-glow gdm-bieres__glow" aria-hidden="true"></div>
  <div class="gdm-container">
    {%- if is_carousel -%}<gdm-carousel>{%- endif -%}

    <div class="gdm-head gdm-head--split">
      {%- if s.pill != blank -%}
        <p class="gdm-pill" data-gdm-reveal>{{ s.pill | escape }}</p>
      {%- endif -%}
      {%- if title_main != blank or title_end != blank -%}
        <{{ heading_tag }} class="gdm-title" data-gdm-reveal style="--gdm-i: 1;">
          {{- title_main | escape }}{% if title_end != blank %} <em>{{ title_end | escape }}</em>{% endif -%}
        </{{ heading_tag }}>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="gdm-lead" data-gdm-reveal style="--gdm-i: 2;">{{ s.text }}</p>
      {%- endif -%}
      <div class="gdm-head__aside" data-gdm-reveal style="--gdm-i: 2;">
        {%- if s.link_label != blank -%}
          <a class="gdm-link" href="{{ s.link_url | default: collection.url | default: routes.all_products_collection_url }}">
            {{- s.link_label | escape -}}
            {%- render 'gdm-icon', name: 'arrow-up-right' -%}
          </a>
        {%- endif -%}
        {%- if is_carousel -%}
          <div class="gdm-carousel__nav" data-carousel-ui>
            <button type="button" class="gdm-icon-btn" data-prev aria-label="{{ s.label_prev | escape }}">{% render 'gdm-icon', name: 'chevron-left' %}</button>
            <button type="button" class="gdm-icon-btn" data-next aria-label="{{ s.label_next | escape }}">{% render 'gdm-icon', name: 'chevron-right' %}</button>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if is_carousel -%}
      <div class="gdm-carousel__track gdm-bieres__list" data-track tabindex="0" role="region" aria-label="{{ title_main | append: ' ' | append: title_end | strip | escape }}">
        {{ cards }}
      </div>
      <div class="gdm-carousel__progress" data-progress data-carousel-ui aria-hidden="true"><span></span></div>
      </gdm-carousel>
    {%- else -%}
      <div class="gdm-grid gdm-bieres__list">
        {{ cards }}
      </div>
    {%- endif -%}

    {%- if s.show_description and collection.description != blank -%}
      <div class="gdm-bieres__desc">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</gdm-section>

{% stylesheet %}
  .gdm.gdm-bieres .gdm-bieres__glow {
    right: -25%;
    top: -5%;
    opacity: 0.6;
  }

  /* Description de la collection sous les bières : texte courant, même si elle est balisée en titres. */
  .gdm.gdm-bieres .gdm-bieres__desc {
    max-width: 78ch;
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: clamp(24px, 3vw, 32px);
    border-top: 1px solid var(--gdm-border);
    color: var(--gdm-muted);
    font-size: 15px;
    line-height: 1.6;
  }

  .gdm.gdm-bieres .gdm-bieres__desc > :is(p, h2, h3) {
    margin: 0 0 12px;
    color: var(--gdm-muted);
    font-family: var(--gdm-font-body);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: normal;
    text-transform: none;
  }

  .gdm.gdm-bieres .gdm-bieres__desc > :is(p, h2, h3) strong {
    color: var(--gdm-text);
  }

  .gdm.gdm-bieres .gdm-beer {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .gdm.gdm-bieres .gdm-beer:hover {
    transform: translateY(-4px);
  }

  .gdm.gdm-bieres .gdm-beer__media {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: radial-gradient(120% 90% at 50% 100%, var(--gdm-surface-2) 0%, var(--gdm-surface) 60%);
  }

  .gdm.gdm-bieres .gdm-beer__halo {
    position: absolute;
    left: 50%;
    bottom: 6%;
    width: 72%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--gdm-accent-glow), transparent);
    transform: translateX(-50%) scale(0.9);
    opacity: 0.75;
    transition: transform 0.6s var(--gdm-ease), opacity 0.6s var(--gdm-ease);
  }

  .gdm.gdm-bieres .gdm-beer:hover .gdm-beer__halo {
    opacity: 1;
    transform: translateX(-50%) scale(1.15);
  }

  .gdm.gdm-bieres .gdm-beer__img,
  .gdm.gdm-bieres .gdm-beer__media .gdm-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--gdm-ease);
  }

  .gdm.gdm-bieres .gdm-beer__media .gdm-placeholder {
    padding: 18%;
    background: transparent;
  }

  .gdm.gdm-bieres .gdm-beer:hover .gdm-beer__img {
    transform: translateY(-6px) scale(1.04) rotate(-1.5deg);
  }

  .gdm.gdm-bieres .gdm-beer__badges {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .gdm.gdm-bieres .gdm-beer__badge {
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--gdm-accent);
    color: var(--gdm-on-accent);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .gdm.gdm-bieres .gdm-beer__badge--muted {
    background: rgba(255, 255, 255, 0.12);
    color: var(--gdm-text);
  }

  .gdm.gdm-bieres .gdm-beer__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 20px 20px 20px;
    border-top: 1px solid var(--gdm-border);
  }

  .gdm.gdm-bieres .gdm-beer__style {
    color: var(--gdm-accent);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .gdm.gdm-bieres .gdm-beer__title {
    font-family: var(--gdm-font-display);
    font-size: 26px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .gdm.gdm-bieres .gdm-beer__title a {
    color: var(--gdm-text);
    transition: color 0.2s var(--gdm-ease);
  }

  .gdm.gdm-bieres .gdm-beer__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .gdm.gdm-bieres .gdm-beer__title a:hover {
    color: var(--gdm-accent);
  }

  .gdm.gdm-bieres .gdm-beer__specs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .gdm.gdm-bieres .gdm-beer__specs li {
    padding: 5px 10px;
    border: 1px solid var(--gdm-border);
    border-radius: 999px;
    color: var(--gdm-muted);
    font-size: 12px;
    line-height: 1.2;
  }

  .gdm.gdm-bieres .gdm-beer__specs strong {
    color: var(--gdm-text);
    font-weight: 600;
  }

  .gdm.gdm-bieres .gdm-beer__bitter {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--gdm-muted);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .gdm.gdm-bieres .gdm-beer__bitter-bar {
    display: inline-flex;
    gap: 3px;
  }

  .gdm.gdm-bieres .gdm-beer__bitter-bar i {
    width: 16px;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.14);
  }

  .gdm.gdm-bieres .gdm-beer__bitter-bar i.is-on {
    background: var(--gdm-accent);
  }

  .gdm.gdm-bieres .gdm-beer__form {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    gap: 14px;
    margin: 4px 0 0;
  }

  .gdm.gdm-bieres .gdm-beer__variants,
  .gdm.gdm-bieres .gdm-beer__foot,
  .gdm.gdm-bieres .gdm-beer__add {
    position: relative;
    z-index: 1;
  }

  .gdm.gdm-bieres .gdm-beer__variants fieldset {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    min-width: 0;
  }

  .gdm.gdm-bieres .gdm-beer__variants label {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: 0;
    padding: 0 16px;
    border: 1px solid var(--gdm-border-strong);
    border-radius: 999px;
    color: var(--gdm-muted);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: border-color 0.2s var(--gdm-ease), color 0.2s var(--gdm-ease), background-color 0.2s var(--gdm-ease);
  }

  .gdm.gdm-bieres .gdm-beer__variants label:hover {
    border-color: var(--gdm-accent);
    color: var(--gdm-text);
  }

  .gdm.gdm-bieres .gdm-beer__variants input:checked + label {
    border-color: var(--gdm-accent);
    background: var(--gdm-accent-soft);
    color: var(--gdm-accent);
  }

  .gdm.gdm-bieres .gdm-beer__variants input:focus-visible + label {
    outline: 2px solid var(--gdm-accent);
    outline-offset: 2px;
  }

  .gdm.gdm-bieres .gdm-beer__variants label.is-unavailable {
    text-decoration: line-through;
    opacity: 0.55;
  }

  .gdm.gdm-bieres .gdm-beer__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px dashed var(--gdm-border);
  }

  .gdm.gdm-bieres .gdm-beer__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    color: var(--gdm-text);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.1;
  }

  .gdm.gdm-bieres .gdm-beer__from {
    color: var(--gdm-muted);
    font-size: 12px;
    font-weight: 500;
  }

  .gdm.gdm-bieres .gdm-beer__compare {
    color: var(--gdm-muted);
    font-size: 13px;
    font-weight: 500;
  }

  .gdm.gdm-bieres .gdm-beer__add {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin: 0;
    padding: 0 16px 0 12px;
    border: 1px solid var(--gdm-accent);
    border-radius: 999px;
    background: var(--gdm-accent);
    color: var(--gdm-on-accent);
    box-shadow: none;
    font-family: var(--gdm-font-body);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 0.2s var(--gdm-ease), transform 0.2s var(--gdm-ease), box-shadow 0.2s var(--gdm-ease);
  }

  .gdm.gdm-bieres .gdm-beer__add:hover:not(:disabled) {
    background: var(--gdm-accent-hover);
    color: var(--gdm-on-accent);
    box-shadow: 0 10px 24px -12px var(--gdm-accent);
  }

  .gdm.gdm-bieres .gdm-beer__add:disabled {
    border-color: var(--gdm-border-strong);
    background: transparent;
    color: var(--gdm-muted);
    cursor: not-allowed;
  }

  .gdm.gdm-bieres .gdm-beer__add svg {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 749px) {
    .gdm.gdm-bieres .gdm-carousel__track .gdm-beer__media {
      aspect-ratio: 1 / 1;
    }

    .gdm.gdm-bieres .gdm-beer__body {
      gap: 8px;
      padding: 16px;
    }

    .gdm.gdm-bieres .gdm-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .gdm.gdm-bieres .gdm-grid .gdm-beer__body {
      padding: 14px;
    }

    .gdm.gdm-bieres .gdm-grid .gdm-beer__title {
      font-size: 20px;
    }

    .gdm.gdm-bieres .gdm-grid .gdm-beer__foot {
      flex-direction: column;
      align-items: stretch;
    }

    .gdm.gdm-bieres .gdm-grid .gdm-beer__add {
      justify-content: center;
    }

    /* Cartes de la grille sur téléphone : nom, degré et IBU en texte, prix, un seul bouton.
       Sans jauge ni choix du format : le premier format (33cL) est ajouté, le 75cL se
       choisit sur la fiche produit. */
    .gdm.gdm-bieres .gdm-grid :is(.gdm-beer__bitter, .gdm-beer__variants) {
      display: none;
    }

    .gdm.gdm-bieres .gdm-grid .gdm-beer__body {
      gap: 6px;
      padding: 16px 14px 18px;
    }

    .gdm.gdm-bieres .gdm-grid .gdm-beer__specs {
      gap: 0;
    }

    .gdm.gdm-bieres .gdm-grid .gdm-beer__specs li {
      padding: 0;
      border: 0;
      font-size: 13px;
    }

    .gdm.gdm-bieres .gdm-grid .gdm-beer__specs li + li::before {
      content: '·';
      margin: 0 6px;
      color: var(--gdm-muted);
    }

    .gdm.gdm-bieres .gdm-grid .gdm-beer__foot {
      gap: 12px;
      margin-top: 6px;
      padding-top: 0;
      border-top: 0;
    }

    .gdm.gdm-bieres .gdm-grid .gdm-beer__add {
      min-height: 46px;
    }
  }

  /* Ordinateur : cartes produit plus basses (photo carrée). */
  @media (min-width: 990px) {
    .gdm.gdm-bieres .gdm-beer__body {
      gap: 8px;
      padding: 16px;
    }

    .gdm.gdm-bieres .gdm-beer__form {
      gap: 10px;
    }

    .gdm.gdm-bieres .gdm-beer__foot {
      padding-top: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GDM · Nos bières",
  "tag": "section",
  "class": "gdm-shopify-section",
  "settings": [
    {
      "type": "header",
      "content": "En-tête"
    },
    {
      "type": "text",
      "id": "pill",
      "label": "Badge"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Nos"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Titre — partie orange",
      "default": "bières"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Niveau du titre (SEO)",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Texte",
      "default": "Des permanentes aux éphémères Labelle : toutes nos bières sont brassées, fermentées et embouteillées à Bruguières."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texte du lien",
      "default": "Toute la gamme"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Lien",
      "info": "Par défaut : la collection choisie."
    },
    {
      "type": "header",
      "content": "Produits"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Vide sur une page collection : la collection affichée, avec son nom en titre."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Nombre de bières",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "default": "carousel",
      "options": [
        { "value": "carousel", "label": "Carrousel" },
        { "value": "grid", "label": "Grille" }
      ]
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Colonnes sur ordinateur",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "style_source",
      "label": "Petit texte orange au-dessus du nom",
      "default": "custom_style",
      "options": [
        { "value": "none", "label": "Rien" },
        { "value": "custom_style", "label": "Métachamp custom.style" },
        { "value": "type", "label": "Type de produit" },
        { "value": "beer_style", "label": "Style de bière (catégorie Shopify)" },
        { "value": "vendor", "label": "Fournisseur" }
      ],
      "info": "Conseillé : créez un métachamp produit « custom.style » (texte sur une ligne) et indiquez NEIPA, West Coast IPA, Sour framboise… Les bières sans valeur n'affichent rien."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Afficher la description de la collection sous les bières",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_specs",
      "label": "Afficher degré et IBU",
      "default": true,
      "info": "Métachamps custom.degre et custom.ibu."
    },
    {
      "type": "checkbox",
      "id": "show_bitterness",
      "label": "Afficher la jauge d'amertume",
      "default": true,
      "info": "Calculée à partir de l'IBU."
    },
    {
      "type": "checkbox",
      "id": "show_variants",
      "label": "Choix du contenant (33 cL / 75 cL)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Bouton « Ajouter au panier »",
      "default": true,
      "info": "Sinon, un bouton « Voir » mène à la fiche produit."
    },
    {
      "type": "header",
      "content": "Textes des boutons"
    },
    {
      "type": "text",
      "id": "label_add",
      "label": "Ajouter",
      "default": "Ajouter"
    },
    {
      "type": "text",
      "id": "label_view",
      "label": "Voir",
      "default": "Voir"
    },
    {
      "type": "text",
      "id": "label_soldout",
      "label": "Épuisée",
      "default": "Épuisée"
    },
    {
      "type": "text",
      "id": "label_sale",
      "label": "Promo",
      "default": "Promo"
    },
    {
      "type": "text",
      "id": "label_from",
      "label": "À partir de",
      "default": "dès"
    },
    {
      "type": "text",
      "id": "label_bitterness",
      "label": "Amertume",
      "default": "Amertume"
    },
    {
      "type": "text",
      "id": "label_format",
      "label": "Contenant",
      "default": "Contenant"
    },
    {
      "type": "text",
