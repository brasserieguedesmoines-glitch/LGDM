{%- comment -%}
  Le Gué des Moines — Vitrine des bières : les bouteilles alignées debout, avec deux
  grandes flèches rondes. En option, un décor : sol texturé devant un mur sombre
  moucheté d'orange. Sous chaque bouteille : nom, degré, format, prix (en option)
  et ajout au panier direct.
  Les photos produit (fond transparent) sont recadrées pour que toutes les bouteilles
  aient la même taille et reposent sur la même ligne (réglages « Cadrage des photos »).
  Sur une fiche produit, la bière affichée n'est pas répétée.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign page_product_id = product.id
  assign collection = s.collection | default: collection
  assign heading_tag = s.heading_tag | default: 'h2'
  assign photo_top = s.photo_top | divided_by: 100.0
  assign photo_bottom = s.photo_bottom | divided_by: 100.0
  assign pattern = s.pattern_opacity | divided_by: 100.0
  assign region_label = s.title | append: ' ' | append: s.title_accent | strip | default: s.label_region
-%}
{%- render 'gdm-assets' -%}

<gdm-section
  id="gdm-{{ section.id }}"
  class="gdm gdm-vitrine{% if s.show_decor %} gdm-vitrine--decor{% endif %}"
  style="--gdm-bg: {{ s.color_bg }}; --gdm-accent: {{ s.color_accent }}; --gdm-pt: {{ s.padding_top }}px; --gdm-pb: {{ s.padding_bottom }}px; --vt-floor: {{ s.color_floor }}; --vt-h-dk: {{ s.bottle_height }}px; --vt-h-mb: {{ s.bottle_height_mobile }}px; --vt-top: {{ photo_top }}; --vt-bot: {{ photo_bottom }}; --vt-pattern: {{ pattern }};"
>
  {%- if s.show_decor -%}
    <div class="gdm-vitrine__wall" aria-hidden="true"></div>
  {%- endif -%}

  {%- if s.pill != blank or s.title != blank or s.title_accent != blank or s.text != blank or s.link_label != blank -%}
    <div class="gdm-container">
      <div class="gdm-head gdm-head--split gdm-vitrine__head">
        {%- if s.pill != blank -%}
          <p class="gdm-pill" data-gdm-reveal>{{ s.pill | escape }}</p>
        {%- endif -%}
        {%- if s.title != blank or s.title_accent != blank -%}
          <{{ heading_tag }} class="gdm-title" data-gdm-reveal style="--gdm-i: 1;">
            {{- s.title | escape }}{% if s.title_accent != blank %} <em>{{ s.title_accent | escape }}</em>{% endif -%}
          </{{ heading_tag }}>
        {%- endif -%}
        {%- if s.text != blank -%}
          <p class="gdm-lead" data-gdm-reveal style="--gdm-i: 2;">{{ s.text }}</p>
        {%- endif -%}
        {%- if s.link_label != blank -%}
          <div class="gdm-head__aside" data-gdm-reveal style="--gdm-i: 2;">
            <a class="gdm-link" href="{{ s.link_url | default: collection.url | default: routes.all_products_collection_url }}">
              {{- s.link_label | escape -}}
              {%- render 'gdm-icon', name: 'arrow-up-right' -%}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <gdm-carousel class="gdm-vitrine__stage">
    <button type="button" class="gdm-vitrine__arrow gdm-vitrine__arrow--prev" data-prev data-carousel-ui aria-label="{{ s.label_prev | escape }}">
      <svg width="40" height="24" viewBox="0 0 40 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M38 12H3M12 3l-9 9 9 9"/></svg>
    </button>

    <ul class="gdm-vitrine__track" data-track tabindex="0" role="region" aria-label="{{ region_label | escape }}">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: s.limit -%}
          {%- if product.id == page_product_id -%}{%- continue -%}{%- endif -%}
          {%- liquid
            assign current = product.selected_or_first_available_variant
            assign degre = product.metafields.custom.degre.value
            assign image = product.featured_media.preview_image
          -%}
          <li class="gdm-vitrine__item" data-gdm-reveal style="--gdm-i: {{ forloop.index0 | modulo: 6 }};">
            <a class="gdm-vitrine__bottle" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
              {%- if image != blank -%}
                {{ image | image_url: width: 1080 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1080', sizes: '(min-width: 750px) 540px, 320px', alt: '', class: 'gdm-vitrine__img' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'gdm-vitrine__img gdm-vitrine__img--placeholder' }}
              {%- endif -%}
            </a>

            <div class="gdm-vitrine__info">
              <h3 class="gdm-vitrine__name"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              {%- if s.show_specs -%}
                {%- liquid
                  assign specs = ''
                  if degre != blank
                    assign specs = degre | replace: '.', ',' | append: ' %'
                  endif
                  if product.has_only_default_variant == false
                    if specs != blank
                      assign specs = specs | append: ' · '
                    endif
                    assign specs = specs | append: current.title
                  endif
                -%}
                {%- if specs != blank -%}
                  <p class="gdm-vitrine__meta">{{ specs | escape }}</p>
                {%- endif -%}
              {%- endif -%}

              {%- if s.show_price or s.show_add_to_cart -%}
                <div class="gdm-vitrine__buy">
                  {%- if s.show_price -%}
                    <p class="gdm-vitrine__price">
                      {{- current.price | money -}}
                      {%- if current.compare_at_price > current.price %} <s>{{ current.compare_at_price | money }}</s>{% endif -%}
                    </p>
                  {%- endif -%}
                  {%- if s.show_add_to_cart -%}
                    {%- form 'product', product, class: 'gdm-vitrine__form', novalidate: 'novalidate' -%}
                      <input type="hidden" name="id" value="{{ current.id }}">
                      <input type="hidden" name="quantity" value="1">
                      {%- liquid
                        if current.available
                          assign add_label = s.label_add
                        else
                          assign add_label = s.label_soldout
                        endif
                        assign add_full = add_label | append: ' — ' | append: product.title
                        unless product.has_only_default_variant
                          assign add_full = add_full | append: ' ' | append: current.title
                        endunless
                      -%}
                      <button
                        type="submit"
                        name="add"
                        class="gdm-vitrine__add"
                        title="{{ add_full | escape }}"
                        aria-label="{{ add_full | escape }}"
                        {% unless current.available %}disabled{% endunless %}
                      >
                        {%- render 'gdm-icon', name: 'plus', icon_size: 20 -%}
                      </button>
                    {%- endform -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          <li class="gdm-vitrine__item">
            <div class="gdm-vitrine__bottle">
              {%- capture ph -%}product-{{ i }}{%- endcapture -%}
              {{ ph | placeholder_svg_tag: 'gdm-vitrine__img gdm-vitrine__img--placeholder' }}
            </div>
            <div class="gdm-vitrine__info">
              <h3 class="gdm-vitrine__name">Nom de la bière</h3>
              <p class="gdm-vitrine__meta">6,2 % · 33cL</p>
            </div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    <button type="button" class="gdm-vitrine__arrow gdm-vitrine__arrow--next" data-next data-carousel-ui aria-label="{{ s.label_next | escape }}">
      <svg width="40" height="24" viewBox="0 0 40 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 12h35M28 3l9 9-9 9"/></svg>
    </button>
  </gdm-carousel>
</gdm-section>

{% stylesheet %}
  /* Taille d'une bouteille (--vt-h) et de sa photo carrée (--vt-s) : la bouteille occupe
     la photo de --vt-top à --vt-bot (fractions de la hauteur), le reste est transparent. */
  .gdm.gdm-vitrine {
    --vt-h: var(--vt-h-mb);
    --vt-s: calc(var(--vt-h) / (var(--vt-bot) - var(--vt-top)));
    --vt-item: clamp(136px, 40vw, 176px);
    --vt-lift: 24px;
    --vt-arrow: 52px;
    --vt-gutter: clamp(16px, 4vw, 48px);
    padding-bottom: 0;
  }

  @media (min-width: 750px) {
    .gdm.gdm-vitrine {
      --vt-h: var(--vt-h-dk);
      --vt-item: clamp(168px, 13.5vw, 212px);
      --vt-lift: 32px;
      --vt-arrow: 88px;
    }
  }

  /* ---------- Mur : taches de peinture à la couleur d'accent ---------- */
  .gdm.gdm-vitrine .gdm-vitrine__wall {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-color: var(--gdm-accent);
    opacity: var(--vt-pattern);
