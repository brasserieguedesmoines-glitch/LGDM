{%- comment -%}
  Le Gué des Moines — habillage GDM de tout le site. Inclus une fois dans
  layout/theme.liquid, juste après les styles du thème : polices hébergées,
  styles et script des sections « GDM », retouches du thème Kalles
  (assets/gdm-site.css), puis l'habillage propre au contenu affiché
  (pages, articles et collections qui ont leur propre feuille de style).
{%- endcomment -%}
{%- render 'gdm-assets' -%}
{{ 'gdm-site.css' | asset_url | stylesheet_tag }}
{%- liquid
  case request.page_type
    when 'page'
      assign gdm_skin_key = 'page/' | append: page.handle
    when 'article'
      assign gdm_skin_key = 'article/' | append: article.handle
    when 'collection'
      assign gdm_skin_key = 'collection/' | append: collection.handle
  endcase
-%}
{%- if gdm_skin_key -%}
  {%- render 'gdm-page-skin', key: gdm_skin_key -%}
{%- endif -%}
{%- if template.name == 'cart' -%}
  {%- comment -%}
    Page panier : le thème met à jour le panier latéral, absent de cette page. Après un
    changement de quantité ou une suppression, la page est rechargée pour afficher le total à jour.
  {%- endcomment -%}
  <script>
    (function () {
      var nativeFetch = window.fetch;
      var timer;
      window.fetch = function (input) {
        var url = typeof input === 'string' ? input : (input && input.url) || '';
        var request = nativeFetch.apply(this, arguments);
        if (/\/cart\/(change|update|clear)/.test(url)) {
          request.then(function () {
            clearTimeout(timer);
            timer = setTimeout(function () { window.location.reload(); }, 300);
          }, function () {});
        }
        return request;
      };
    })();
  </script>
{%- endif -%}
