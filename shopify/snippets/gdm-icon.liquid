      <circle cx="6.5" cy="17.5" r="1.8" fill="currentColor"/>
      <circle cx="17.5" cy="17.5" r="1.8" fill="currentColor"/>
    {%- when 'bag' -%}
      <path d="M5.5 7.5h13l-1 13h-11l-1-13z"/>
      <path d="M9 10V6.5a3 3 0 0 1 6 0V10"/>
    {%- when 'sparkle' -%}
