    {%- when 'lock' -%}
      <rect x="4.5" y="10.5" width="15" height="10.5" rx="2.5"/>
      <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
      <circle cx="12" cy="15.75" r="1.4" fill="currentColor" stroke="none"/>
    {%- when 'shield' -%}
      <path d="M12 2.8 4.5 5.8v5.4c0 4.7 3.1 8.6 7.5 10 4.4-1.4 7.5-5.3 7.5-10V5.8L12 2.8z"/>
      <path d="m8.8 12 2.2 2.2 4.2-4.4"/>
    {%- when 'store' -%}
      <path d="M3.5 9.5 5 4h14l1.5 5.5"/>
      <path d="M3.5 9.5a2.8 2.8 0 0 0 5.6 0 2.8 2.8 0 0 0 5.8 0 2.8 2.8 0 0 0 5.6 0"/>
      <path d="M5 11.8V20h14v-8.2"/>
      <path d="M10 20v-5h4v5"/>
    {%- when 'send' -%}
      <path d="M21 3 10.5 13.5"/>
      <path d="m21 3-6.5 18-4-7.5L3 9.5 21 3z"/>
    {%- when 'gift' -%}
      <rect x="3.5" y="8" width="17" height="4" rx="1"/>
      <path d="M5 12v8.5h14V12M12 8v12.5"/>
      <path d="M12 8C10.5 5 7.5 4.2 7 5.8 6.4 7.8 10 8 12 8zm0 0c1.5-3 4.5-3.8 5-2.2.6 2-3 2.2-5 2.2z"/>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="17" height="17" rx="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>
