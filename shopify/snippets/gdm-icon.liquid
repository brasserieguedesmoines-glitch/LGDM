      <path d="M5 19c3.5-4.5 6.5-7.5 10-10"/>
    {%- when 'award' -%}
      <circle cx="12" cy="9" r="6"/>
      <path d="m8.6 13.9-1.4 7.6 4.8-2.7 4.8 2.7-1.4-7.6"/>
    {%- when 'heart' -%}
      <path d="M12 20.3s-7.6-4.6-7.6-10.4A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.6 2.7c0 5.8-7.6 10.4-7.6 10.4z"/>
    {%- when 'users' -%}
      <circle cx="9" cy="8" r="3.8"/>
      <path d="M2.5 20.5a6.5 6.5 0 0 1 13 0"/>
      <path d="M16 4.4a3.8 3.8 0 0 1 0 7.2M21.5 20.5a6.5 6.5 0 0 0-3.8-5.9"/>
    {%- when 'map-pin' -%}
      <path d="M12 21.5s-7-6.1-7-11.8a7 7 0 0 1 14 0c0 5.7-7 11.8-7 11.8z"/>
      <circle cx="12" cy="9.7" r="2.6"/>
    {%- when 'clock' -%}
