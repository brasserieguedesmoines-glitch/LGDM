{%- comment -%}
  Carte bière GDM (sections Nos bières et Recherche).
  Paramètres : product, s (réglages de la section : style_source, show_specs,
  show_bitterness, show_variants, show_add_to_cart et libellés), card_id
  (identifiant unique des pastilles de format), index (rang, pour l'apparition décalée).
  Styles : sections/gdm-bieres.liquid (classe gdm-bieres sur le conteneur).
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign degre = product.metafields.custom.degre.value
  assign ibu = product.metafields.custom.ibu.value
  assign style_label = ''
  case s.style_source
    when 'custom_style'
      assign style_label = product.metafields.custom.style.value
    when 'type'
      assign style_label = product.type
    when 'vendor'
      assign style_label = product.vendor
    when 'beer_style'
      for style in product.metafields.shopify['beer-style'].value
        if style.label != blank
          assign style_label = style.label
          break
        endif
      endfor
  endcase
  assign image = product.featured_media.preview_image
  assign image_alt = image.alt | default: product.title
  assign show_pills = false
  if s.show_variants and product.has_only_default_variant == false and product.variants.size <= 4
    assign show_pills = true
  endif
-%}
<article class="gdm-beer gdm-card" data-product-card data-gdm-reveal style="--gdm-i: {{ index | modulo: 4 }};">
  <a class="gdm-beer__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    <span class="gdm-beer__halo"></span>
    {%- if image != blank -%}
      {{ image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 45vw, 80vw', alt: image_alt, class: 'gdm-beer__img' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'gdm-placeholder' }}
    {%- endif -%}
    <span class="gdm-beer__badges">
      {%- unless product.available -%}
        <span class="gdm-beer__badge gdm-beer__badge--muted">{{ s.label_soldout | escape }}</span>
      {%- endunless -%}
      {%- if product.compare_at_price > product.price -%}
        <span class="gdm-beer__badge">{{ s.label_sale | escape }}</span>
      {%- endif -%}
    </span>
  </a>

  <div class="gdm-beer__body">
    {%- if style_label != blank -%}
      <p class="gdm-beer__style">{{ style_label | escape }}</p>
    {%- endif -%}
    <h3 class="gdm-beer__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    {%- if s.show_specs and degre != blank or s.show_specs and ibu != blank -%}
      <ul class="gdm-beer__specs">
        {%- if degre != blank -%}
          <li><strong>{{ degre | replace: '.', ',' }} %</strong> alc.</li>
        {%- endif -%}
        {%- if ibu != blank -%}
          <li><strong>{{ ibu }}</strong> IBU</li>
        {%- endif -%}
      </ul>
    {%- endif -%}

    {%- if s.show_bitterness and ibu != blank -%}
      {%- liquid
        assign ibu_num = ibu | plus: 0
        assign level = ibu_num | divided_by: 15.0 | ceil
        if level > 5
          assign level = 5
        elsif level < 1
          assign level = 1
        endif
      -%}
      <div class="gdm-beer__bitter" title="{{ s.label_bitterness | escape }} : {{ level }}/5">
        <span class="gdm-beer__bitter-label">{{ s.label_bitterness | escape }}</span>
        <span class="gdm-beer__bitter-bar" role="img" aria-label="{{ s.label_bitterness | escape }} {{ level }}/5">
          {%- for i in (1..5) -%}<i{% if i <= level %} class="is-on"{% endif %}></i>{%- endfor -%}
        </span>
      </div>
    {%- endif -%}

    {%- form 'product', product, class: 'gdm-beer__form', novalidate: 'novalidate' -%}
      {%- if show_pills -%}
        <gdm-variant-pills class="gdm-beer__variants">
          <fieldset>
            <legend class="gdm-visually-hidden">{{ s.label_format | escape }}</legend>
            {%- for variant in product.variants -%}
              {%- assign pill_id = card_id | append: '-' | append: product.id | append: '-' | append: variant.id -%}
              <input
                type="radio"
                id="{{ pill_id }}"
                name="id"
                value="{{ variant.id }}"
                class="gdm-visually-hidden"
                data-variant-price="{{ variant.price | money | strip_html | escape }}"
                data-variant-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | strip_html | escape }}{% endif %}"
                data-variant-available="{{ variant.available }}"
                {% if variant.id == current.id %}checked{% endif %}
              >
              <label for="{{ pill_id }}"{% unless variant.available %} class="is-unavailable"{% endunless %}>{{ variant.title | escape }}</label>
            {%- endfor -%}
          </fieldset>
        </gdm-variant-pills>
      {%- else -%}
        <input type="hidden" name="id" value="{{ current.id }}">
      {%- endif -%}
      <input type="hidden" name="quantity" value="1">

      <div class="gdm-beer__foot">
        <p class="gdm-beer__price">
          {%- if show_pills == false and product.price_varies -%}
            <span class="gdm-beer__from">{{ s.label_from | escape }}</span>
            <span data-price>{{ product.price_min | money }}</span>
          {%- else -%}
            <span data-price>{{ current.price | money }}</span>
            <s class="gdm-beer__compare" data-compare-price{% unless current.compare_at_price > current.price %} hidden{% endunless %}>
              {%- if current.compare_at_price > current.price %}{{ current.compare_at_price | money }}{% endif -%}
            </s>
          {%- endif -%}
        </p>

        {%- if s.show_add_to_cart -%}
          <button
            type="submit"
            name="add"
            class="gdm-beer__add"
            data-add-to-cart
            data-label-add="{{ s.label_add | escape }}"
            data-label-soldout="{{ s.label_soldout | escape }}"
            {% unless current.available %}disabled{% endunless %}
          >
            {%- render 'gdm-icon', name: 'plus', icon_size: 18 -%}
            <span data-add-label>{% if current.available %}{{ s.label_add | escape }}{% else %}{{ s.label_soldout | escape }}{% endif %}</span>
            <span class="gdm-visually-hidden"> — {{ product.title | escape }}</span>
          </button>
        {%- else -%}
          <a class="gdm-beer__add" href="{{ product.url }}">
            {%- render 'gdm-icon', name: 'arrow-up-right', icon_size: 18 -%}
            <span>{{ s.label_view | escape }}</span>
            <span class="gdm-visually-hidden"> — {{ product.title | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endform -%}
  </div>
</article>
